#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Rendered { float rendered[]; };
layout(std430, set = 0, binding = 1) readonly buffer Target { float target[]; };
layout(std430, set = 0, binding = 2) buffer DLDpixels { float dL_dpixels[]; };
layout(std430, set = 0, binding = 3) buffer Partials { float partials[]; };
layout(std430, set = 0, binding = 4) readonly buffer Alpha { float alpha[]; };
layout(std430, set = 0, binding = 5) readonly buffer Beta { float beta[]; };
layout(std430, set = 0, binding = 6) readonly buffer Gamma { float gamma[]; };

layout(push_constant) uniform PC {
    uint W;
    uint H;
    uint num_elements;
    float lambda_dssim;
} pc;

const float K[11] = float[11](
    0.0010283801,
    0.0075987581,
    0.0360007721,
    0.1093606895,
    0.2130055377,
    0.2660117249,
    0.2130055377,
    0.1093606895,
    0.0360007721,
    0.0075987581,
    0.0010283801);

uint clamp_u(int v, uint hi) {
    return uint(clamp(v, 0, int(hi)));
}

float transpose_weight_1d(uint pixel, uint center, uint limit) {
    float w = 0.0;
    for (int d = -5; d <= 5; ++d) {
        if (clamp_u(int(center) + d, limit - 1u) == pixel) {
            w += K[d + 5];
        }
    }
    return w;
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.num_elements || pc.lambda_dssim == 0.0) return;

    uint HW = pc.W * pc.H;
    uint ch = gid / HW;
    uint p = gid - ch * HW;
    uint x = p % pc.W;
    uint y = p / pc.W;
    uint base = ch * HW;

    uint cx0 = x > 5u ? x - 5u : 0u;
    uint cx1 = min(pc.W - 1u, x + 5u);
    uint cy0 = y > 5u ? y - 5u : 0u;
    uint cy1 = min(pc.H - 1u, y + 5u);

    float adj_alpha = 0.0;
    float adj_beta = 0.0;
    float adj_gamma = 0.0;
    for (uint cy = cy0; cy <= cy1; ++cy) {
        float wy = transpose_weight_1d(y, cy, pc.H);
        for (uint cx = cx0; cx <= cx1; ++cx) {
            float w = wy * transpose_weight_1d(x, cx, pc.W);
            uint idx = base + cy * pc.W + cx;
            adj_alpha += w * alpha[idx];
            adj_beta += w * beta[idx];
            adj_gamma += w * gamma[idx];
        }
    }

    float d_ssim_dx = adj_alpha + target[gid] * adj_beta + rendered[gid] * adj_gamma;
    dL_dpixels[gid] += -pc.lambda_dssim * (1.0 / float(pc.num_elements)) * d_ssim_dx;
}
