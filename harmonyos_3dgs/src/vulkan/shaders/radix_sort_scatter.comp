#version 450
#extension GL_ARB_gpu_shader_int64 : require

// SP-2 radix_sort_scatter.comp — stable scatter using bucket offsets
// (spec §4.8.5).
//
// Given:
//   keys_in[tid], values_in[tid] — the per-element input
//   bucket_offsets[wg_id*16 + b] — exclusive prefix-sum of histograms,
//                                  i.e. the global output position where
//                                  WG `wg_id`'s bucket-b elements begin
// This shader writes each element to its assigned output slot, preserving
// STABILITY — elements that fall in the same bucket must retain their
// original relative order.
//
// SP-2 Phase 1 scope: SINGLE-WORKGROUP variant. Caller dispatches exactly
// one WG (gl_NumWorkGroups.x == 1, num_elements <= 256). With wg_id == 0
// the scatter degenerates to bucket_offsets[b] (index 0*16+b == b), which
// is what prefix_sum.comp over histograms[0..15] produces. Multi-WG
// stable scatter is deferred to Phase 2.
//
// Stability strategy: thread-0 sequential assignment.
// We compute per-thread buckets in parallel (phase 1), then let a single
// thread walk elements 0..num_elements-1 in ASCENDING order and assign
// each one the next output slot for its bucket (phase 2). Because thread 0
// processes indices in their original order, elements in the same bucket
// land in increasing output positions — that's exactly stability. This is
// O(num_elements) serial work but num_elements <= 256 for Phase 1, so it
// is well under the cost of the barrier sync.
// A parallel stable algorithm (e.g. warp-level prefix scans per bucket)
// would be faster but is unnecessary at this scale and would complicate
// the Phase 2 multi-WG rewrite.
//
// Bindings — must match radix_scatter_bind:: in
// include/vulkan/preprocess_bindings.h:
//   binding 0 = keys_in        (RO, uint64_t[])
//   binding 1 = values_in      (RO, uint[])
//   binding 2 = bucket_offsets (RO, uint[], length num_wgs*16)
//   binding 3 = keys_out       (WO, uint64_t[])
//   binding 4 = values_out     (WO, uint[])
// Push constants — must match RadixSortPushConstants (16 bytes).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly  buffer KeysIn        { uint64_t keys_in[];        };
layout(std430, set = 0, binding = 1) readonly  buffer ValuesIn      { uint     values_in[];      };
layout(std430, set = 0, binding = 2) readonly  buffer BucketOff     { uint     bucket_offsets[]; };
layout(std430, set = 0, binding = 3) writeonly buffer KeysOut       { uint64_t keys_out[];       };
layout(std430, set = 0, binding = 4) writeonly buffer ValuesOut     { uint     values_out[];     };

layout(push_constant) uniform PC {
    uint num_elements;
    uint current_bit;   // 0, 4, 8, ..., 60
    uint _pad0;
    uint _pad1;
} pc;

// Per-thread bucket (0..15) and assigned output slot.
shared uint s_bucket[256];
shared uint s_pos[256];

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint tid = gl_GlobalInvocationID.x;

    // Phase 1: each thread extracts the 4-bit bucket for its element.
    // Out-of-range lanes leave s_bucket[lid] undefined — phase 2 only
    // reads s_bucket[k] for k < num_elements, and phase 3 only writes for
    // tid < num_elements.
    if (tid < pc.num_elements) {
        s_bucket[lid] = uint((keys_in[tid] >> pc.current_bit) & uint64_t(0xFu));
    }
    barrier();

    // Phase 2: thread 0 sequentially assigns stable output positions.
    // We seed a local 16-entry cursor from this WG's bucket offsets, then
    // walk elements in ascending k order, handing out and post-incrementing
    // the cursor for each bucket. Ascending-k traversal is what guarantees
    // stability.
    //
    // Single-WG variant: gl_WorkGroupID.x == 0 so the cursor reads
    // bucket_offsets[0*16 + b] = bucket_offsets[b]. For a future multi-WG
    // rewrite, replace `bucket_offsets[b]` with
    // `bucket_offsets[gl_WorkGroupID.x * 16u + b]`.
    if (lid == 0u) {
        uint cursor[16];
        for (uint b = 0u; b < 16u; b++) {
            cursor[b] = bucket_offsets[b];
        }
        for (uint k = 0u; k < pc.num_elements; k++) {
            uint b = s_bucket[k];
            s_pos[k] = cursor[b];
            cursor[b] = cursor[b] + 1u;
        }
    }
    barrier();

    // Phase 3: each in-range thread moves its (key, value) pair to the
    // slot phase 2 assigned. Out-of-range lanes skip.
    if (tid < pc.num_elements) {
        uint slot = s_pos[lid];
        keys_out[slot]   = keys_in[tid];
        values_out[slot] = values_in[tid];
    }
}
