#version 450
#extension GL_ARB_gpu_shader_int64 : require

// SP-2 radix_sort_count.comp — per-workgroup 4-bit histogram (spec §4.8.4).
//
// LSD radix sort over uint64 keys, 4 bits per pass, 16 passes total
// (current_bit = 0, 4, 8, ..., 60). One full sort iteration is:
//   1) count   (this shader): per-WG histogram of the 4-bit bucket
//   2) scan    (prefix_sum.comp): exclusive scan over the histograms
//   3) scatter (radix_sort_scatter.comp): stable scatter using bucket offsets
//
// SP-2 Phase 1 scope: SINGLE-WORKGROUP variant. Caller dispatches exactly
// one WG (gl_NumWorkGroups.x == 1), so R must be <= 256 (the WG size).
// Tiny fixture has R = 103 which fits. Multi-WG stable radix is deferred
// to Phase 2 and will require a wg-local stable scatter + global offsets.
//
// Output layout (matches prefix_sum.comp input contract):
//   histograms[bucket * num_workgroups + wg_id] = count of keys in this WG that
//                                                 have ((key >> current_bit) & 0xF) == bucket.
// Bucket-major layout makes one global exclusive scan produce bucket bases plus
// per-bucket prefixes over earlier workgroups.
//
// Bindings — must match radix_count_bind:: in
// include/vulkan/preprocess_bindings.h (KEYS_IN=0, HISTOGRAMS=1).
// Push constants — must match RadixSortPushConstants (16 bytes).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer KeysIn     { uint64_t keys_in[];    };
layout(std430, set = 0, binding = 1)          buffer Histograms { uint     histograms[]; };

layout(push_constant) uniform PC {
    uint num_elements;
    uint current_bit;   // 0, 4, 8, ..., 60
    uint num_workgroups;
    uint _pad1;
} pc;

// Per-WG 16-bucket histogram, updated via shared-memory atomicAdd.
shared uint s_hist[16];

void main() {
    uint lid   = gl_LocalInvocationID.x;
    uint tid   = gl_GlobalInvocationID.x;
    uint wg_id = gl_WorkGroupID.x;

    // Zero the shared histogram before any thread reads/writes it. First 16
    // threads cover the 16 buckets; the rest skip. barrier() synchronises
    // the whole WG so the atomicAdd phase sees zeroed memory.
    if (lid < 16u) {
        s_hist[lid] = 0u;
    }
    barrier();

    // Each in-range thread extracts the 4-bit bucket from its key and
    // atomicAdds into the shared histogram. Out-of-range threads (tid >=
    // num_elements, which happens when num_elements is not a multiple of
    // 256) skip — they must not touch the histogram.
    if (tid < pc.num_elements) {
        uint bucket = uint((keys_in[tid] >> pc.current_bit) & uint64_t(0xFu));
        atomicAdd(s_hist[bucket], 1u);
    }
    barrier();

    // Publish the 16 per-WG counts to global memory. The scan pass reads
    // histograms[0 .. num_wgs*16) as its input array.
    if (lid < 16u) {
        histograms[lid * pc.num_workgroups + wg_id] = s_hist[lid];
    }
}
