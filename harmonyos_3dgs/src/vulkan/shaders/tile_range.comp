// tile_range.comp — spec §4.8.6
//
// Sweeps through sorted keys (ordered by tile_id in high 32 bits, then depth
// in low 32 bits) and writes per-tile start/end indices into tile_ranges[].
//
// One thread per sort element. Each thread inspects its left and right
// neighbours to detect tile boundaries:
//   - Left boundary  → write tile_ranges[tile_id*2+0] = i   (inclusive start)
//   - Right boundary → write tile_ranges[tile_id*2+1] = i+1 (exclusive end)
//
// PRECONDITION: tile_ranges[] must be zero-initialised by the caller before
// dispatch. Tiles with no Gaussians are never written and remain [0,0) = empty.
//
// Bindings match tile_range_bind:: in preprocess_bindings.h (spec §4.8.6).

#version 450
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// binding=0  tile_range_bind::KEYS_SORTED
layout(std430, set = 0, binding = 0) readonly buffer KeysSorted {
    uint64_t keys_sorted[];
};

// binding=1  tile_range_bind::TILE_RANGES
// Interleaved: [start0, end0, start1, end1, ...]  size = num_tiles * 2
layout(std430, set = 0, binding = 1) buffer TileRanges {
    uint tile_ranges[];
};

// TileRangePushConstants — 16 bytes (spec §4.8.6)
layout(push_constant) uniform PC {
    uint num_elements;  // R — total number of sort key/value pairs
    uint num_tiles;
    uint _pad0;
    uint _pad1;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.num_elements) return;

    uint tile_id_cur = uint(keys_sorted[i] >> 32u);

    // Is this element the first in its tile?
    bool is_start = (i == 0u) ||
                    (uint(keys_sorted[i - 1u] >> 32u) != tile_id_cur);

    // Is this element the last in its tile?
    bool is_end = (i == pc.num_elements - 1u) ||
                  (uint(keys_sorted[i + 1u] >> 32u) != tile_id_cur);

    if (is_start) tile_ranges[tile_id_cur * 2u + 0u] = i;        // inclusive start
    if (is_end)   tile_ranges[tile_id_cur * 2u + 1u] = i + 1u;   // exclusive end
}
