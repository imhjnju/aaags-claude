#version 450

#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer RecordsSorted {
    uint records_sorted[];
};

layout(std430, set = 0, binding = 1) writeonly buffer KeysSorted {
    uint64_t keys_sorted[];
};

layout(std430, set = 0, binding = 2) writeonly buffer ValuesSorted {
    uint values_sorted[];
};

layout(std430, set = 0, binding = 3) buffer TileRanges {
    uint tile_ranges[];
};

layout(push_constant) uniform Push {
    uint num_elements;
    uint num_tiles;
    uint compact_key48;
    uint _pad1;
} pc;

uint key_hi(uint i) {
    const uint base = i * 3u;
    if (pc.compact_key48 != 0u) {
        return records_sorted[base + 2u] >> 16u;
    }
    return records_sorted[base + 2u];
}

uint64_t key_at(uint i) {
    const uint base = i * 3u;
    if (pc.compact_key48 != 0u) {
        const uint depth = (records_sorted[base + 1u] >> 16u) |
                           ((records_sorted[base + 2u] & 0xFFFFu) << 16u);
        const uint tile = records_sorted[base + 2u] >> 16u;
        return (uint64_t(tile) << 32u) | uint64_t(depth);
    }
    return (uint64_t(records_sorted[base + 2u]) << 32u) | uint64_t(records_sorted[base + 1u]);
}

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.num_elements) return;

    const uint64_t key = key_at(i);
    const uint tile = uint(key >> 32u);
    keys_sorted[i] = key;
    values_sorted[i] = records_sorted[i * 3u + 0u];

    if (tile >= pc.num_tiles) return;

    const bool is_start = (i == 0u) || (key_hi(i - 1u) != tile);
    const bool is_end = (i + 1u == pc.num_elements) || (key_hi(i + 1u) != tile);

    if (is_start) tile_ranges[tile * 2u] = i;
    if (is_end) tile_ranges[tile * 2u + 1u] = i + 1u;
}
