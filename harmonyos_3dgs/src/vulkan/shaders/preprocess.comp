#version 450

// SP-2 preprocess.comp — per-Gaussian projection + 2D covariance + SH color.
// Spec §4.8.1 (14 bindings: 13 SSBO+1 UBO + 1 radius_f SSBO at binding 13).
//
// Numerical target: match the CPU reference in
//   harmonyos_3dgs/src/cpu/preprocessor_cpu.cpp   (eval_3D=false, antialiasing=false)
//   harmonyos_3dgs/src/math_utils.cpp             (computeCov3D / computeCov2D)
//   harmonyos_3dgs/src/sh_eval.cpp                (computeColorFromSH)
//
// Key numerical conventions we intentionally replicate:
//   - GaussianData.scales     are already exp()-activated (ply_loader.cpp:exp)
//     -> shader consumes them directly; do NOT apply exp() here.
//   - GaussianData.opacities  are already sigmoid()-activated (ply_loader.cpp:sigmoid)
//     -> shader writes `opacity_activated = opacities[i]` directly; NO sigmoid here.
//     (Plan Task 4 step 10 says "sigmoid(raw_opacity)" but that contradicts CPU
//      reference + types.h; matching CPU is required for golden parity.)
//   - Quaternion order (r, x, y, z) per math_utils.cpp:quat2mat.
//   - Pixel coordinate: ndc2Pix(v, S) = ((v+1)*S - 1) * 0.5
//     (includes the -0.5 half-pixel offset; matches ndc2Pix in math_utils.h).
//   - cov2D frustum clamp to 1.3x tan_fov (limx/limy) before Jacobian.
//   - +0.3 low-pass dilation to cov2D diagonal.
//   - eigenvalue floor: max(0.1, mid*mid - det).
//   - radius cull: if radius > max(W,H) -> cull.
//   - tile rect computed with getRect logic (clamp to grid bounds).

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ---- Specialization constants -----------------------------------------------
layout(constant_id = 0) const uint spec_training   = 1u;  // 1 = training (no SH clamp upper)
layout(constant_id = 1) const uint spec_eval_3D    = 0u;  // 1 = eval_3D path
layout(constant_id = 2) const uint spec_proper_ewa = 0u;  // 1 = AAA proper_ewa_scaling + tight_opacity_bounding + rect_bounding

// ---- Push constants (24 bytes, spec §4.8.1) --------------------------------
layout(push_constant) uniform PC {
    uint  num_gaussians;
    uint  sh_degree;
    uint  sh_coeffs_per_g;   // (sh_degree+1)^2
    uint  num_tiles_x;
    uint  num_tiles_y;
    float scale_modifier;
} pc;

// ---- SSBOs (bindings 0..11) -------------------------------------------------
layout(std430, set = 0, binding = 0)  readonly buffer BufPositions  { float positions[];  };
layout(std430, set = 0, binding = 1)  readonly buffer BufScales     { float scales[];     };
layout(std430, set = 0, binding = 2)  readonly buffer BufRotations  { float rotations[];  };
layout(std430, set = 0, binding = 3)  readonly buffer BufOpacities  { float opacities[];  };
layout(std430, set = 0, binding = 4)  readonly buffer BufSH         { float sh[];         };
layout(std430, set = 0, binding = 5)  readonly buffer BufFilter3D   { float filter_3D[];  };

layout(std430, set = 0, binding = 6)  writeonly buffer BufMeans2D   { float means2D[];    };
layout(std430, set = 0, binding = 7)  writeonly buffer BufDepths    { float depths[];     };
// Packed {conic.a, conic.b, conic.c, opacity} per Gaussian (stride 4 floats)
layout(std430, set = 0, binding = 8)  writeonly buffer BufConicOp   { float conic_opacity_packed[]; };
layout(std430, set = 0, binding = 9)  writeonly buffer BufRGB       { float rgb[];        };
layout(std430, set = 0, binding = 10) writeonly buffer BufRadii      { int   radii[];       };
layout(std430, set = 0, binding = 11) writeonly buffer BufTiles      { int   tiles_touched[]; };

// ---- Float radius SSBO (binding 13, after UBO at 12) -----------------------
layout(std430, set = 0, binding = 13) writeonly buffer BufRadiusF    { float radius_f_arr[]; };

// ---- ForwardCache SSBOs for backward pass (bindings 14..18) ----------------
layout(std430, set = 0, binding = 14) writeonly buffer BufCov3DCache    { float cov3D_cache[];    };  // [N*6]
layout(std430, set = 0, binding = 15) writeonly buffer BufPViewCache    { float p_view_cache[];   };  // [N*3]
layout(std430, set = 0, binding = 16) writeonly buffer BufPHomWCache    { float p_hom_w_cache[];  };  // [N]
layout(std430, set = 0, binding = 17) writeonly buffer BufCov2DCache    { float cov2D_cache[];    };  // [N*3] dilated cov2D (fa, fb, fc)
layout(std430, set = 0, binding = 18) writeonly buffer BufCov2DDetCache { float cov2D_det_cache[];};  // [N]   det = fa*fc - fb*fb

// ---- eval_3D output SSBOs (bindings 19..21) --------------------------------
layout(std430, set = 0, binding = 19) writeonly buffer BufGauss2Screen { float gauss2screen_out[]; };  // [N*16]
layout(std430, set = 0, binding = 20) writeonly buffer BufCov3DInv     { float cov3D_inv_out[];     };  // [N*6]
layout(std430, set = 0, binding = 21) writeonly buffer BufMeanOffset   { float mean_offset_out[];   };  // [N*3]

// ---- Camera UBO (binding 12, std140, 224 bytes) -----------------------------
layout(std140, set = 0, binding = 12) uniform CameraUBO {
    mat4 viewmatrix;           // 64B
    mat4 projmatrix;           // 64B (full view*proj)
    mat4 inv_viewprojmatrix;   // 64B
    vec4 campos_pad;           // 16B: xyz=campos, w=0
    vec4 fov_size;             // 16B: x=tan_fovx, y=tan_fovy, z=width, w=height
} cam;

