// -----------------------------------------------------------------------------
// computeCov3D: Sigma = M^T * M, where M[i][j] = s[i] * R[i][j]
// Matches math_utils.cpp::computeCov3D.
// Output: cov3D[0..5] = [xx, xy, xz, yy, yz, zz] (upper triangle).
// -----------------------------------------------------------------------------
void computeCov3D(vec3 scale, float mod_, vec4 rot, out float cov3D[6]) {
    float sx = mod_ * scale.x;
    float sy = mod_ * scale.y;
    float sz = mod_ * scale.z;

    float R[9];
    quat2mat(rot, R);

    // M[i][j] = s[i] * R[i][j]
    float M[9];
    for (int j = 0; j < 3; j++) {
        M[0 * 3 + j] = sx * R[0 * 3 + j];
        M[1 * 3 + j] = sy * R[1 * 3 + j];
        M[2 * 3 + j] = sz * R[2 * 3 + j];
    }

    // Sigma = M^T * M (symmetric). Sigma[r][c] = sum_k M[k][r] * M[k][c].
    cov3D[0] = M[0]*M[0] + M[3]*M[3] + M[6]*M[6]; // [0][0]
    cov3D[1] = M[0]*M[1] + M[3]*M[4] + M[6]*M[7]; // [0][1]
    cov3D[2] = M[0]*M[2] + M[3]*M[5] + M[6]*M[8]; // [0][2]
    cov3D[3] = M[1]*M[1] + M[4]*M[4] + M[7]*M[7]; // [1][1]
    cov3D[4] = M[1]*M[2] + M[4]*M[5] + M[7]*M[8]; // [1][2]
    cov3D[5] = M[2]*M[2] + M[5]*M[5] + M[8]*M[8]; // [2][2]
}

// -----------------------------------------------------------------------------
// computeCov2D: project 3D covariance into 2D screen cov via Jacobian.
// Matches math_utils.cpp::computeCov2D (which mirrors CUDA forward.cu /
// forward_common.h:93).
//
// W convention (important — easy to get wrong):
//   The CPU reference (math_utils.cpp:96-100) and CUDA forward_common.h:93 use
//   a row-vector/left-multiply formulation where `W` is the TRANSPOSE of the
//   upper-left 3x3 of the column-major viewmatrix. Equivalently, W's rows are
//   the viewmatrix's column vectors. We therefore construct W as
//     transpose(mat3(cam.viewmatrix))
//   because mat3(mat4) in GLSL extracts the viewmatrix's first three columns
//   as the new mat3's columns (preserving column-major storage); transpose()
//   turns those columns into rows to match the math derivation.
//
// J[col][row] (column-major), CPU convention:
//   col0 = (fx/z, 0, -fx*tx/z^2)
//   col1 = (0, fy/z, -fy*ty/z^2)
//   col2 = (0, 0, 0)
//
// T = W * J      (mat3 multiply, both column-major)
// result = transpose(T) * Vrk * T   (Vrk symmetric, so Vrk^T = Vrk)
// -----------------------------------------------------------------------------
void computeCov2D(vec3 mean3d, float cov3D[6],
                  float focal_x, float focal_y,
                  float tan_fovx, float tan_fovy,
                  out vec3 cov2D_out)
{
    // mean3d -> view space. Use precise helpers to match CPU (no FMA).
    // The view-space position feeds into the Jacobian which determines cov2D,
    // radius, and tile coverage — precision here prevents tile-assignment drift.
    vec3 t = vec3(
        preciseTransformRow(cam.viewmatrix, mean3d, 0),
        preciseTransformRow(cam.viewmatrix, mean3d, 1),
        preciseTransformRow(cam.viewmatrix, mean3d, 2));

    // Clamp to 1.3x frustum boundary (CPU lines 73-79).
    float limx = 1.3 * tan_fovx;
    float limy = 1.3 * tan_fovy;
    float txtz = t.x / t.z;
    float tytz = t.y / t.z;
    t.x = min(limx, max(-limx, txtz)) * t.z;
    t.y = min(limy, max(-limy, tytz)) * t.z;

    // J (column-major, mat3).
    mat3 J = mat3(
        vec3(focal_x / t.z, 0.0, -(focal_x * t.x) / (t.z * t.z)),  // col 0
        vec3(0.0, focal_y / t.z, -(focal_y * t.y) / (t.z * t.z)),  // col 1
        vec3(0.0, 0.0, 0.0));                                       // col 2

    // W = transpose(upper-left 3x3 of viewmatrix) — matches CUDA forward_common.h:93
    // and CPU math_utils.cpp:96-100. mat3(mat4) extracts columns; transpose() gives
    // the math-transposed upper 3x3 that the Jacobian derivation requires.
    mat3 W = transpose(mat3(cam.viewmatrix));

    // T = W * J
    mat3 T = W * J;

    // Vrk from upper-triangle cov3D.
    mat3 Vrk = mat3(
        vec3(cov3D[0], cov3D[1], cov3D[2]),  // col 0 (symmetric cov)
        vec3(cov3D[1], cov3D[3], cov3D[4]),  // col 1
        vec3(cov3D[2], cov3D[4], cov3D[5])); // col 2

    // cov = transpose(T) * Vrk * T  (Vrk symmetric, so Vrk^T = Vrk)
    mat3 result = transpose(T) * Vrk * T;

    cov2D_out.x = result[0][0];   // a
    cov2D_out.y = result[1][0];   // b  (column 1, row 0)
    cov2D_out.z = result[1][1];   // c
}

// -----------------------------------------------------------------------------
// Compute tile AABB using CUDA getRect semantics (auxiliary.h::getRect).
//   rect_min.x = clamp(floor((pix.x - extent) / tile_w), 0, grid_x)
//   rect_min.y = clamp(floor((pix.y - extent) / tile_h), 0, grid_y)
//   rect_max.x = clamp(ceil ((pix.x + extent) / tile_w), 0, grid_x)
//   rect_max.y = clamp(ceil ((pix.y + extent) / tile_h), 0, grid_y)
// Tiles touched = (max.x - min.x) * (max.y - min.y).
//
// Extent is the *float* radius (before ceil-to-int); CUDA forward.cu:256-258
// stores `rect_dims = (radius, radius)` as float2 and uses it in getRect.
// Integer-truncation ("+tile-1" ceil trick) breaks on fractional pixel
// positions — verified against golden in T7 (tiles_touched[8,13] diverged
// from CUDA until this switched to true floor/ceil on the float extent).
//
// CPU reference (preprocessor_cpu.cpp) uses int my_radius (post-ceil) and
// the "+tile-1" trick; Vulkan intentionally diverges from CPU here so the
// SP-0 tiny-fixture golden match (T7) is bit-exact.
// -----------------------------------------------------------------------------
ivec2 rectMin(vec2 p, float extent_x, float extent_y, int grid_x, int grid_y, int tile_w, int tile_h) {
    int mx = int(floor((p.x - extent_x) / float(tile_w)));
    int my = int(floor((p.y - extent_y) / float(tile_h)));
    mx = min(grid_x, max(0, mx));
    my = min(grid_y, max(0, my));
    return ivec2(mx, my);
}

ivec2 rectMax(vec2 p, float extent_x, float extent_y, int grid_x, int grid_y, int tile_w, int tile_h) {
    int mx = int(ceil((p.x + extent_x) / float(tile_w)));
    int my = int(ceil((p.y + extent_y) / float(tile_h)));
    mx = min(grid_x, max(0, mx));
    my = min(grid_y, max(0, my));
    return ivec2(mx, my);
}

// -----------------------------------------------------------------------------
// SH evaluation — matches harmonyos_3dgs/src/sh_eval.cpp::computeColorFromSH.
// sh layout: sh[i * K * 3 + k*3 + ch] where K = sh_coeffs_per_g.
//
// Training mode: only lower-clamp rgb+0.5 to 0; do NOT clamp upper (kills grad).
// Inference mode (spec_training == 0): clamp to [0, 1].
// -----------------------------------------------------------------------------
vec3 shToRGB(uint i, vec3 pos, vec3 cam_pos, uint sh_degree, uint K) {
    // normalized view dir (from camera to Gaussian center)
    vec3 dir = pos - cam_pos;
    dir = normalize(dir);
    float x = dir.x, y = dir.y, z = dir.z;

    uint base = i * K * 3u;

    // Degree 0
    vec3 result = SH_C0 * vec3(sh[base + 0u*3u + 0u],
                               sh[base + 0u*3u + 1u],
                               sh[base + 0u*3u + 2u]);

    if (sh_degree > 0u) {
        vec3 sh1 = vec3(sh[base + 1u*3u + 0u], sh[base + 1u*3u + 1u], sh[base + 1u*3u + 2u]);
        vec3 sh2 = vec3(sh[base + 2u*3u + 0u], sh[base + 2u*3u + 1u], sh[base + 2u*3u + 2u]);
        vec3 sh3 = vec3(sh[base + 3u*3u + 0u], sh[base + 3u*3u + 1u], sh[base + 3u*3u + 2u]);
        result += -SH_C1 * y * sh1 + SH_C1 * z * sh2 - SH_C1 * x * sh3;

        if (sh_degree > 1u) {
            float xx = x*x, yy = y*y, zz = z*z;
            float xy = x*y, yz = y*z, xz = x*z;
            vec3 sh4 = vec3(sh[base + 4u*3u + 0u], sh[base + 4u*3u + 1u], sh[base + 4u*3u + 2u]);
            vec3 sh5 = vec3(sh[base + 5u*3u + 0u], sh[base + 5u*3u + 1u], sh[base + 5u*3u + 2u]);
            vec3 sh6 = vec3(sh[base + 6u*3u + 0u], sh[base + 6u*3u + 1u], sh[base + 6u*3u + 2u]);
            vec3 sh7 = vec3(sh[base + 7u*3u + 0u], sh[base + 7u*3u + 1u], sh[base + 7u*3u + 2u]);
            vec3 sh8 = vec3(sh[base + 8u*3u + 0u], sh[base + 8u*3u + 1u], sh[base + 8u*3u + 2u]);
            result += SH_C2_0 * xy * sh4
                   +  SH_C2_1 * yz * sh5
                   +  SH_C2_2 * (2.0*zz - xx - yy) * sh6
                   +  SH_C2_3 * xz * sh7
                   +  SH_C2_4 * (xx - yy) * sh8;

            if (sh_degree > 2u) {
                vec3 sh9  = vec3(sh[base +  9u*3u + 0u], sh[base +  9u*3u + 1u], sh[base +  9u*3u + 2u]);
                vec3 sh10 = vec3(sh[base + 10u*3u + 0u], sh[base + 10u*3u + 1u], sh[base + 10u*3u + 2u]);
                vec3 sh11 = vec3(sh[base + 11u*3u + 0u], sh[base + 11u*3u + 1u], sh[base + 11u*3u + 2u]);
                vec3 sh12 = vec3(sh[base + 12u*3u + 0u], sh[base + 12u*3u + 1u], sh[base + 12u*3u + 2u]);
                vec3 sh13 = vec3(sh[base + 13u*3u + 0u], sh[base + 13u*3u + 1u], sh[base + 13u*3u + 2u]);
                vec3 sh14 = vec3(sh[base + 14u*3u + 0u], sh[base + 14u*3u + 1u], sh[base + 14u*3u + 2u]);
                vec3 sh15 = vec3(sh[base + 15u*3u + 0u], sh[base + 15u*3u + 1u], sh[base + 15u*3u + 2u]);
                result += SH_C3_0 * y * (3.0*xx - yy) * sh9
                       +  SH_C3_1 * xy * z * sh10
                       +  SH_C3_2 * y * (4.0*zz - xx - yy) * sh11
                       +  SH_C3_3 * z * (2.0*zz - 3.0*xx - 3.0*yy) * sh12
                       +  SH_C3_4 * x * (4.0*zz - xx - yy) * sh13
                       +  SH_C3_5 * z * (xx - yy) * sh14
                       +  SH_C3_6 * x * (xx - 3.0*yy) * sh15;
            }
        }
    }

    result += vec3(0.5);
    result = max(result, vec3(0.0));
    if (spec_training == 0u) {
        result = min(result, vec3(1.0));
    }
    return result;
}

// -----------------------------------------------------------------------------
// Main
// -----------------------------------------------------------------------------
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.num_gaussians) return;

    // Default outputs for culled paths.
    // means2D=(0,0) matches CUDA forward.cu where rejected Gaussians leave
    // points_xy_image untouched and the host tensor is zero-initialised
    // (parity gate VkVsCudaFirstLoss.Gate_P1_Means2D, 2026-04-25).
    radii[i]         = 0;
    tiles_touched[i] = 0;
    radius_f_arr[i*2u + 0u] = 0.0;
    radius_f_arr[i*2u + 1u] = 0.0;
    means2D[i*2u + 0u] = 0.0;
    means2D[i*2u + 1u] = 0.0;

    // Zero-fill ForwardCache fields for culled paths.
    cov3D_cache[i*6u+0u]=0.0; cov3D_cache[i*6u+1u]=0.0; cov3D_cache[i*6u+2u]=0.0;
    cov3D_cache[i*6u+3u]=0.0; cov3D_cache[i*6u+4u]=0.0; cov3D_cache[i*6u+5u]=0.0;
    p_view_cache[i*3u+0u]=0.0; p_view_cache[i*3u+1u]=0.0; p_view_cache[i*3u+2u]=0.0;
    p_hom_w_cache[i]=0.0;
    cov2D_cache[i*3u+0u]=0.0; cov2D_cache[i*3u+1u]=0.0; cov2D_cache[i*3u+2u]=0.0;
    cov2D_det_cache[i]=0.0;

    // Zero-fill eval_3D outputs for culled paths.
    if (spec_eval_3D == 1u) {
        for (uint j = 0u; j < 16u; j++) gauss2screen_out[i*16u+j] = 0.0;
        for (uint j = 0u; j < 6u; j++)  cov3D_inv_out[i*6u+j] = 0.0;
        mean_offset_out[i*3u] = 0.0;
        mean_offset_out[i*3u+1u] = 0.0;
        mean_offset_out[i*3u+2u] = 0.0;
    }

    vec3 position = vec3(positions[i*3u + 0u],
                         positions[i*3u + 1u],
                         positions[i*3u + 2u]);

    // 3. World -> view (used for both 2D and eval_3D paths).
    // Use precise helpers to match CPU's -ffp-contract=off (no FMA).
    // The depth (p_view.z) is the sort key in the 2D path.
    vec3 p_view = vec3(
        preciseTransformRow(cam.viewmatrix, position, 0),
        preciseTransformRow(cam.viewmatrix, position, 1),
        preciseTransformRow(cam.viewmatrix, position, 2));
    // Near-plane cull only in the 2D path. CUDA's eval_3D path gates this on
    // splatting_settings.near_clipping (forward.cu:136), which is false by default
    // and absent from configs/aaa.json, so eval_3D renders near-camera Gaussians
    // (near_clipping=false). The eval_3D branch below relies on the
    // camera-inside-ellipsoid test + frustum/AABB culling to reject invalid splats.
    if (spec_eval_3D == 0u && p_view.z <= 0.2) return;

    // =========================================================================
    // eval_3D branch: AAA-Gaussians 3D evaluation path
    // Port of preprocessor_cpu.cpp:65-188 (eval_3D=true)
    // =========================================================================
    if (spec_eval_3D == 1u) {
        float width_3d  = cam.fov_size.z;
        float height_3d = cam.fov_size.w;
        float tan_fovx_3d = cam.fov_size.x;
        float tan_fovy_3d = cam.fov_size.y;
        float focal_x_3d = width_3d  / (2.0 * tan_fovx_3d);
        float focal_y_3d = height_3d / (2.0 * tan_fovy_3d);

        float opacity_3d = opacities[i];
        float focal_3d = max(focal_x_3d, focal_y_3d);
        float filter_3d = filter_3D[i];

        vec3 scale_3d = vec3(scales[i*3u + 0u], scales[i*3u + 1u], scales[i*3u + 2u]);
        vec4 rot_3d   = vec4(rotations[i*4u + 0u], rotations[i*4u + 1u],
                             rotations[i*4u + 2u], rotations[i*4u + 3u]);
        vec3 cam_pos_3d = cam.campos_pad.xyz;

        // Compute gauss2screen and gauss2view matrices
        float gauss2screen[16];
        float gauss2view[16];
        float dilation_factor = computeGauss2Screen(
            position, scale_3d, rot_3d,
            pc.scale_modifier, cam_pos_3d,
            focal_3d, 0.3, filter_3d,
            width_3d, height_3d,
            gauss2screen, gauss2view);

        // Gate dilation_factor opacity scaling on spec_proper_ewa, matching
        // CUDA cuda_rasterizer/forward.cu:157
        //     `opacity *= proper_ewa_scaling ? dilation_factor : 1.0f;`
        // proper_ewa=true  (aaa.json / basketball cam0 golden): apply dilation.
        // proper_ewa=false (parity harness dump_cuda_training_step.py): identity.
        if (spec_proper_ewa == 1u) opacity_3d *= dilation_factor;
        const float ALPHA_THRESHOLD = 1.0 / 255.0;
        // CUDA sentinel convention: rejected Gaussians leave means2D untouched in
        // forward.cu (no write before RETURN_OR_INACTIVE at line 158). The host
        // torch tensor is zero-initialised, so the comparison reference is (0,0).
        // VK matches by writing (0,0) explicitly because the SSBO contents are
        // undefined across dispatches.
        if (opacity_3d < ALPHA_THRESHOLD) { means2D[i*2u]=0.0; means2D[i*2u+1u]=0.0; return; }

        float opacity_power_threshold = log(opacity_3d / ALPHA_THRESHOLD);
        float cutoff_3d = min(11.11, 2.0 * opacity_power_threshold);

        // Camera-inside-ellipsoid test
        // Recompute scale_dilated (same formula as inside computeGauss2Screen)
        float R_3d[9];
        quat2mat(rot_3d, R_3d);
        float sm_3d = sqrt(pc.scale_modifier);

        float scale_dilated[3] = float[3](scale_3d.x, scale_3d.y, scale_3d.z);
        {
            float mean_view_z = preciseTransformRow(cam.viewmatrix, position, 2);
            float scale_mip = (mean_view_z / focal_3d) * (mean_view_z / focal_3d) * 0.3;
            scale_mip = max(filter_3d * filter_3d, scale_mip);
            for (int j = 0; j < 3; j++)
                scale_dilated[j] = sqrt(scale_3d[j]*scale_3d[j] + scale_mip);
        }

        float sd_3d[3];
        for (int j = 0; j < 3; j++)
            sd_3d[j] = scale_dilated[j] * sm_3d;

        // Compute inverse 3D covariance
        float cov3D_inv_local[6];
        computeCov3DInv_3D(vec3(scale_dilated[0], scale_dilated[1], scale_dilated[2]),
                           pc.scale_modifier, rot_3d, cov3D_inv_local);

        // Store mean_offset = position - cam_pos
        mean_offset_out[i*3u]     = position.x - cam_pos_3d.x;
        mean_offset_out[i*3u+1u]  = position.y - cam_pos_3d.y;
        mean_offset_out[i*3u+2u]  = position.z - cam_pos_3d.z;

        // campos_gauss = world2gauss * (cam_pos - mean3D)
        // world2gauss row j = (1/sd[j]) * R[j]
        vec3 diff_3d = cam_pos_3d - position;
        float campos_gauss[3];
        for (int j = 0; j < 3; j++) {
            campos_gauss[j] = (RMC(R_3d, j, 0)*diff_3d.x +
                               RMC(R_3d, j, 1)*diff_3d.y +
                               RMC(R_3d, j, 2)*diff_3d.z) / sd_3d[j];
        }

        float dist_sq = campos_gauss[0]*campos_gauss[0] +
                         campos_gauss[1]*campos_gauss[1] +
                         campos_gauss[2]*campos_gauss[2];
        if (dist_sq < cutoff_3d) { means2D[i*2u]=0.0; means2D[i*2u+1u]=0.0; return; }  // Camera inside ellipsoid (cite: forward.cu:166-167)

        // 3D frustum culling
        float max_pos_depth;
        float max_contrib = maxContribGaussianFrustum3D(
            0.0, 0.0, width_3d - 1.0, height_3d - 1.0,
            gauss2screen, max_pos_depth);
        if (max_contrib > opacity_power_threshold) { means2D[i*2u]=0.0; means2D[i*2u+1u]=0.0; return; }  // 3D frustum cull (cite: forward.cu:182-184)

        // NDC projection for tile assignment (same as 2D path)
        vec4 p_hom_3d = vec4(
            preciseTransformRow4(cam.projmatrix, position, 0),
            preciseTransformRow4(cam.projmatrix, position, 1),
            preciseTransformRow4(cam.projmatrix, position, 2),
            preciseTransformRow4(cam.projmatrix, position, 3));
        precise float p_w_3d = 1.0 / (p_hom_3d.w + 1e-7);
        precise float pixel_x_3d = ndc2Pix(p_hom_3d.x * p_w_3d, width_3d);
        precise float pixel_y_3d = ndc2Pix(p_hom_3d.y * p_w_3d, height_3d);

        // View-space AABB for extent estimation.
        // CUDA default: new_aabb=true → always uses compute_aabb_view, never
        // compute_aabb_screen.  We must match this to produce identical tile
        // assignments and Gaussian-tile pair counts.
        float mean2D_aabb[2];
        float extent_aabb[2];
        bool aabb_ok = computeAABBView(gauss2view, p_view, focal_x_3d, focal_y_3d,
                                       width_3d, height_3d, cutoff_3d,
                                       mean2D_aabb, extent_aabb);
        if (!aabb_ok) { means2D[i*2u]=0.0; means2D[i*2u+1u]=0.0; return; }  // AABB invalid (cite: forward.cu:186-190)

        // Tile rect — separate x/y extents matching CUDA's getRect(p, float2).
        // scatter.comp reads radius_f_arr[i*2+0/1] to reconstruct the identical rect.
        float extent_x_3d = extent_aabb[0];
        float extent_y_3d = extent_aabb[1];
        const int TILE_W = 16;
        const int TILE_H = 16;
        int grid_x_3d = int(pc.num_tiles_x);
        int grid_y_3d = int(pc.num_tiles_y);
        vec2 center_3d = vec2(mean2D_aabb[0], mean2D_aabb[1]);
        ivec2 rmn_3d = rectMin(center_3d, extent_x_3d, extent_y_3d, grid_x_3d, grid_y_3d, TILE_W, TILE_H);
        ivec2 rmx_3d = rectMax(center_3d, extent_x_3d, extent_y_3d, grid_x_3d, grid_y_3d, TILE_W, TILE_H);
        int n_tiles_3d = (rmx_3d.x - rmn_3d.x) * (rmx_3d.y - rmn_3d.y);
        if (n_tiles_3d == 0) { means2D[i*2u]=0.0; means2D[i*2u+1u]=0.0; return; }  // zero tiles touched (cite: forward.cu:266-269)
        int my_radius_3d = int(ceil(max(extent_x_3d, extent_y_3d)));
        my_radius_3d = max(my_radius_3d, 1);

        // SH color evaluation
        vec3 color_3d = shToRGB(i, position, cam_pos_3d, pc.sh_degree, pc.sh_coeffs_per_g);

        // ---- Write outputs ----
        // Packed conic_opacity: slots 0-2 unused in eval_3D mode, slot 3 = opacity
        conic_opacity_packed[i*4u + 0u] = 0.0;
        conic_opacity_packed[i*4u + 1u] = 0.0;
        conic_opacity_packed[i*4u + 2u] = 0.0;
        conic_opacity_packed[i*4u + 3u] = opacity_3d;

        // CUDA stores AABB center as means2D in eval_3D (not projected pixel).
        means2D[i*2u + 0u] = mean2D_aabb[0];
        means2D[i*2u + 1u] = mean2D_aabb[1];
        depths[i]          = p_view.z;
        rgb[i*3u + 0u]     = color_3d.x;
        rgb[i*3u + 1u]     = color_3d.y;
        rgb[i*3u + 2u]     = color_3d.z;

        radii[i]         = my_radius_3d;
        tiles_touched[i] = n_tiles_3d;
        radius_f_arr[i*2u + 0u] = extent_x_3d;  // scatter.comp reads both to reconstruct rect
        radius_f_arr[i*2u + 1u] = extent_y_3d;

        // eval_3D specific outputs
        for (uint j = 0u; j < 16u; j++) gauss2screen_out[i*16u+j] = gauss2screen[j];
        for (uint j = 0u; j < 6u; j++)  cov3D_inv_out[i*6u+j] = cov3D_inv_local[j];

        // Cache p_view for backward
        p_view_cache[i*3u+0u] = p_view.x;
        p_view_cache[i*3u+1u] = p_view.y;
        p_view_cache[i*3u+2u] = p_view.z;
        // Cache p_hom_w for backward
        p_hom_w_cache[i] = p_hom_3d.w;

        return;
    }
    // =========================================================================
    // End eval_3D branch — fallthrough is the standard 2D path below
    // =========================================================================

    // 4. View -> clip -> NDC -> pixel using ndc2Pix (matches CPU).
    // Precise computation of p_hom to match CPU's transformPoint4x4.
    // Pixel coordinates determine tile assignment — precision matters.
    vec4 p_hom = vec4(
        preciseTransformRow4(cam.projmatrix, position, 0),
        preciseTransformRow4(cam.projmatrix, position, 1),
        preciseTransformRow4(cam.projmatrix, position, 2),
        preciseTransformRow4(cam.projmatrix, position, 3));
    float p_w  = 1.0 / (p_hom.w + 1e-7);
    vec3 p_ndc = vec3(p_hom.x * p_w, p_hom.y * p_w, p_hom.z * p_w);

    float width  = cam.fov_size.z;
    float height = cam.fov_size.w;
    float pixel_x = ndc2Pix(p_ndc.x, width);
    float pixel_y = ndc2Pix(p_ndc.y, height);

    // 5. cov3D.
    vec3 scale = vec3(scales[i*3u + 0u], scales[i*3u + 1u], scales[i*3u + 2u]);
    vec4 rot   = vec4(rotations[i*4u + 0u], rotations[i*4u + 1u],
                      rotations[i*4u + 2u], rotations[i*4u + 3u]);
    float cov3D[6];
    computeCov3D(scale, pc.scale_modifier, rot, cov3D);

    // 6. cov2D via Jacobian.
    float tan_fovx = cam.fov_size.x;
    float tan_fovy = cam.fov_size.y;
    float focal_x = width  / (2.0 * tan_fovx);
    float focal_y = height / (2.0 * tan_fovy);
    vec3 cov2D;
    computeCov2D(position, cov3D, focal_x, focal_y, tan_fovx, tan_fovy, cov2D);

    // 7. Dilate cov2D (AAA 0.3 low-pass filter).
    cov2D.x += 0.3;
    cov2D.z += 0.3;

    // 8. Determinant.
    float det = cov2D.x * cov2D.z - cov2D.y * cov2D.y;
    if (det == 0.0) return;  // CPU tests `det == 0.0f`.

    // Cache dilated cov2D and det for backward pass (bindings 17..18).
    uint base3 = i * 3u;
    cov2D_cache[base3 + 0u]  = cov2D.x;
    cov2D_cache[base3 + 1u]  = cov2D.y;
    cov2D_cache[base3 + 2u]  = cov2D.z;
    cov2D_det_cache[i]        = det;

    // 9. Conic = inverse(cov2D) upper triangle.
    float det_inv = 1.0 / det;
    vec3 conic = vec3(cov2D.z * det_inv,  // a
                      -cov2D.y * det_inv, // b
                      cov2D.x * det_inv); // c

    // 10. Opacity — GaussianData.opacities is already sigmoid-activated.
    float opacity_activated = opacities[i];
    float final_opacity = opacity_activated;

    // Radius computation — two modes controlled by spec_proper_ewa.
    float radius_f;
    float extent_x;
    float extent_y;
    int   my_radius;
    int   n_tiles = 0;

    if (spec_proper_ewa == 1u) {
        // AAA proper_ewa_scaling + tight_opacity_bounding + rect_bounding.
        // Recompute pre-dilation determinant for convolution_scaling_factor.
        float det_orig = (cov2D.x - 0.3) * (cov2D.z - 0.3) - cov2D.y * cov2D.y;
        float det_dilated = det;
        float convolution_scaling = sqrt(max(0.000025, det_orig / det_dilated));
        final_opacity = opacity_activated * convolution_scaling;

        const float TOB_ALPHA_THRESHOLD = 1.0 / 255.0;
        float opt = log(final_opacity / TOB_ALPHA_THRESHOLD);
        float extent_2d = min(3.33, sqrt(max(0.0, 2.0 * opt)));

        float mid = 0.5 * (cov2D.x + cov2D.z);
        float disc = max(0.01, mid * mid - det);
        float lambda = mid + sqrt(disc);
        radius_f = extent_2d * sqrt(lambda);
        my_radius = int(ceil(radius_f));

        extent_x = min(extent_2d * sqrt(max(0.0, cov2D.x)), radius_f);
        extent_y = min(extent_2d * sqrt(max(0.0, cov2D.z)), radius_f);
    } else {
        // SP-2 basic path: fixed extent 3.33, isotropic radius.
        float mid = 0.5 * (cov2D.x + cov2D.z);
        float disc = max(0.01, mid * mid - det);
        float lambda = mid + sqrt(disc);
        radius_f = 3.33 * sqrt(lambda);
        my_radius = int(ceil(radius_f));

        extent_x = radius_f;
        extent_y = radius_f;
    }

    // 13. Tile AABB.
    const int TILE_W = 16;
    const int TILE_H = 16;
    int grid_x = int(pc.num_tiles_x);
    int grid_y = int(pc.num_tiles_y);
    vec2 pix  = vec2(pixel_x, pixel_y);
    ivec2 rmn = rectMin(pix, extent_x, extent_y, grid_x, grid_y, TILE_W, TILE_H);
    ivec2 rmx = rectMax(pix, extent_x, extent_y, grid_x, grid_y, TILE_W, TILE_H);
    n_tiles = (rmx.x - rmn.x) * (rmx.y - rmn.y);
    if (n_tiles == 0) return;

    // 15. SH → RGB.
    vec3 cam_pos = cam.campos_pad.xyz;
    vec3 color = shToRGB(i, position, cam_pos, pc.sh_degree, pc.sh_coeffs_per_g);

    // ---- Writes ----
    // 11. Packed conic_opacity.
    conic_opacity_packed[i*4u + 0u] = conic.x;
    conic_opacity_packed[i*4u + 1u] = conic.y;
    conic_opacity_packed[i*4u + 2u] = conic.z;
    conic_opacity_packed[i*4u + 3u] = final_opacity;

    // 14. Per-Gaussian outputs.
    means2D[i*2u + 0u] = pixel_x;
    means2D[i*2u + 1u] = pixel_y;
    depths[i]          = p_view.z;
    rgb[i*3u + 0u]     = color.x;
    rgb[i*3u + 1u]     = color.y;
    rgb[i*3u + 2u]     = color.z;

    radii[i]         = my_radius;
    tiles_touched[i] = n_tiles;
    radius_f_arr[i*2u + 0u] = extent_x;  // asymmetric per rect_bounding
    radius_f_arr[i*2u + 1u] = extent_y;

    // Cache intermediates for backward pass (bindings 14..16).
    // cov3D: 6-element upper triangle computed by computeCov3D().
    cov3D_cache[i*6u+0u] = cov3D[0];
    cov3D_cache[i*6u+1u] = cov3D[1];
    cov3D_cache[i*6u+2u] = cov3D[2];
    cov3D_cache[i*6u+3u] = cov3D[3];
    cov3D_cache[i*6u+4u] = cov3D[4];
    cov3D_cache[i*6u+5u] = cov3D[5];
    // p_view: view-space position (xyz).
    p_view_cache[i*3u+0u] = p_view.x;
    p_view_cache[i*3u+1u] = p_view.y;
    p_view_cache[i*3u+2u] = p_view.z;
    // p_hom_w: raw clip-space w (NOT 1/w — matches CPU cache->p_hom_w = p_hom[3]).
    p_hom_w_cache[i] = p_hom.w;
}
