#version 450

// SP-2 rasterize.comp — per-tile alpha blending (spec §4.8.7).
//
// One workgroup = one 16x16 tile. Each invocation = one pixel. The workgroup
// cooperatively loads batches of up to 256 Gaussians from the sorted list for
// its tile into shared memory, then every pixel-thread walks the batch in
// sort order and front-to-back alpha-blends Gaussians that cover it until
// transmittance T falls below a threshold or the tile's Gaussian list ends.
//
// CUDA reference: AAA-Gaussians/submodules/diff-gaussian-rasterization/
//   cuda_rasterizer/forward.cu: renderCUDA(...) — the algorithm we mirror.
//
// Bindings match rasterize_bind:: in include/vulkan/preprocess_bindings.h.
//
// NUMERICAL CONTRACTS (match CUDA bit-for-bit given identical inputs):
//   - alpha threshold    : ALPHA_THRESHOLD = 1.0 / 255.0
//   - T  (early-out)     : T_MIN           = 0.0001
//   - alpha cap          : min(0.99, opacity * exp(power))   (forward.cu:366)
//   - power              : -0.5*(a*dx^2 + c*dy^2) - b*dx*dy
//     Note: conic_opacity_packed[b] is the raw off-diagonal cov2D_inv[0][1],
//     NOT pre-halved. Formula matches forward.cu:
//       float power = -0.5f*(con_o.x*d.x*d.x + con_o.z*d.y*d.y)
//                     - con_o.y*d.x*d.y;
//   - power > 0 skip     : Gaussian evaluated behind its own peak — skip.
//   - n_contrib          : count of Gaussians actually blended into C
//                          (those passing both alpha >= 1/255 AND test_T >= T_MIN).
//                          The Gaussian that first trips T < T_MIN is NOT counted.
//   - output layout      : CHW. out_image[ch*H*W + y*W + x].
//   - background         : final color = C_accum + T_final * bg_color (always
//                          applied, even when bg is zero).
//
// Shared memory footprint: 10 arrays * 256 floats (or uints) = 10 * 1024 B =
// 10.24 KB. Safely under Vulkan 1.1 guaranteed 16 KB shared memory minimum.
//
// Synchronisation: barriers bracket each batch's cooperative load; pixels
// whose tile has early-terminated still participate in barriers so divergent
// pixel_done states don't hang the workgroup (no barrier inside the per-pixel
// k-loop — that loop is fully divergent but contains no barrier calls).

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// binding 0 — sorted Gaussian indices (one per (Gaussian, tile) pair).
layout(std430, set = 0, binding = 0) readonly buffer ValuesSorted {
    uint values_sorted[];
};

// binding 1 — [start0, end0, start1, end1, ...] inclusive/exclusive per tile.
layout(std430, set = 0, binding = 1) readonly buffer TileRanges {
    uint tile_ranges[];
};

// binding 2 — means2D interleaved [x0,y0, x1,y1, ...].
layout(std430, set = 0, binding = 2) readonly buffer Means2D {
    float means2D[];
};

// binding 3 — packed [a, b, c, opacity] per Gaussian (stride 4 floats).
layout(std430, set = 0, binding = 3) readonly buffer ConicOpacity {
    float conic_opacity[];
};

// binding 4 — per-Gaussian RGB [r,g,b] interleaved (stride 3 floats).
layout(std430, set = 0, binding = 4) readonly buffer RGB {
    float rgb[];
};

// binding 5 — output image, CHW: [R-plane | G-plane | B-plane], each H*W.
layout(std430, set = 0, binding = 5) writeonly buffer OutImage {
    float out_image[];
};

// binding 6 — per-pixel final transmittance (H*W floats).
layout(std430, set = 0, binding = 6) writeonly buffer Transmittance {
    float transmittance[];
};

// binding 7 — per-pixel blended-Gaussian count (H*W uints).
layout(std430, set = 0, binding = 7) writeonly buffer NContrib {
    uint n_contrib[];
};

// binding 8 — background colour UBO (std140, 16 bytes).
layout(std140, set = 0, binding = 8) uniform RasterUBO {
    vec4 bg_color;  // (R, G, B, unused)
};

// eval_3D bindings (9..13) — only accessed when spec_eval_3D == 1.
layout(std430, set = 0, binding = 9)  readonly buffer Gauss2Screen { float gauss2screen[]; };  // [N*16] row-major
layout(std430, set = 0, binding = 10) readonly buffer Opacities2D  { float opacities_2d[]; };  // [N] pre-dilated opacity
layout(std430, set = 0, binding = 11) readonly buffer Cov3DInv     { float cov3D_inv[];    };  // [N*6] inverse 3D cov
layout(std430, set = 0, binding = 12) readonly buffer MeanOffset   { float mean_offset[];  };  // [N*3] (pos - cam_pos)
layout(std140, set = 0, binding = 13) uniform RasterEval3DUBO {
    mat4 inverse_vp;        // 64B: inverse viewproj (column-major)
    vec4 cam_pos_pad;       // 16B: xyz=cam_pos, w=0
    vec4 img_size_pad;      // 16B: x=width, y=height, z=0, w=0
} eval3d_ubo;

// Specialization constant: 0=2D conic path, 1=eval_3D k-buffer path.
layout(constant_id = 0) const uint spec_eval_3D = 0u;

// RasterizePushConstants — 20 bytes (spec §4.8.7).
layout(push_constant) uniform PC {
    uint num_gaussians;  // layout padding — kept to match RasterizePushConstants (spec §4.8.7)
    uint image_width;
    uint image_height;
    uint num_tiles_x;
    uint num_tiles_y;    // layout padding — kept to match RasterizePushConstants (spec §4.8.7)
} pc;

// --- Shared cache of the current batch (up to 256 Gaussians) ---
shared float s_mean_x [256];
shared float s_mean_y [256];
shared float s_conic_a[256];
shared float s_conic_b[256];
shared float s_conic_c[256];
shared float s_opacity[256];
shared float s_rgb_r  [256];
shared float s_rgb_g  [256];
shared float s_rgb_b  [256];
shared uint  s_gid    [256];

// eval_3D shared memory: gauss2screen all 4 rows (16 floats per Gaussian),
// opacity. s_rgb_r/g/b and s_gid are reused from 2D path.
// Total eval_3D: 16*256*4 + 1*256*4 + reused = ~17 KB + 4 KB reused.
shared float s_g2s  [256 * 16];  // all 4 rows of gauss2screen (need row 2 for depth)
shared float s_opa  [256];       // pre-dilated opacity (eval_3D)

const float ALPHA_THRESHOLD = 1.0 / 255.0;  // forward.cu: alpha < 1/255
const float T_MIN           = 0.0001;       // forward.cu: test_T < 0.0001
const uint  BATCH_SIZE      = 256u;         // 16*16 pixels per tile.

// --- eval_3D helper functions ------------------------------------------------

// Port of CUDA consistent_common.cuh:max_contrib_ray.
// Returns squared Mahalanobis distance (peak exponent) and sets max_pos to
// the closest-approach point on the ray (in Gaussian homogeneous coordinates).
// Caller uses max_pos with g2s rows 2,3 to compute NDC depth.
float maxContribRayPixel(float plane_a[4], float plane_b[4], out float max_pos[4]) {
    float dx = plane_a[1]*plane_b[2] - plane_a[2]*plane_b[1];
    float dy = plane_a[2]*plane_b[0] - plane_a[0]*plane_b[2];
    float dz = plane_a[0]*plane_b[1] - plane_a[1]*plane_b[0];
    float mx = plane_a[3]*plane_b[0] - plane_a[0]*plane_b[3];
    float my = plane_a[3]*plane_b[1] - plane_a[1]*plane_b[3];
    float mz = plane_a[3]*plane_b[2] - plane_a[2]*plane_b[3];
    float dd = dx*dx + dy*dy + dz*dz;
    if (dd < 1e-8) {
        max_pos = float[4](0.0, 0.0, 0.0, 1.0);
        return 0.0;
    }
    float m_div_dd[3] = float[3](mx/dd, my/dd, mz/dd);
    max_pos[0] = dy*m_div_dd[2] - dz*m_div_dd[1];
    max_pos[1] = dz*m_div_dd[0] - dx*m_div_dd[2];
    max_pos[2] = dx*m_div_dd[1] - dy*m_div_dd[0];
    max_pos[3] = 1.0;
    return mx*m_div_dd[0] + my*m_div_dd[1] + mz*m_div_dd[2];
}

void main() {
    // --- Tile → range lookup ---
    uint tile_id = gl_WorkGroupID.y * pc.num_tiles_x + gl_WorkGroupID.x;
    uint range_start = tile_ranges[tile_id * 2u + 0u];
    uint range_end   = tile_ranges[tile_id * 2u + 1u];

    // --- Per-pixel coordinates ---
    uint pixel_x = gl_WorkGroupID.x * 16u + gl_LocalInvocationID.x;
    uint pixel_y = gl_WorkGroupID.y * 16u + gl_LocalInvocationID.y;
    bool valid_pixel = (pixel_x < pc.image_width) && (pixel_y < pc.image_height);

    // Linear index into shared cache for cooperative loads (0..255).
    uint local_idx = gl_LocalInvocationIndex;

    // Per-pixel accumulators.
    float T = 1.0;
    vec3  C = vec3(0.0);
    uint  n = 0u;
    // Pixels outside the image still participate in cooperative loads/barriers
    // but contribute nothing; treat them as already-done for the blending loop.
    bool pixel_done = !valid_pixel;

    if (spec_eval_3D == 1u) {
    // =================================================================
    // eval_3D path: per-pixel k-buffer sort (HEAD_WINDOW=4).
    // Port of CUDA PER_PIXEL_KBUFFER mode (resorted_render.cuh).
    // Each pixel maintains a 4-entry sorted window by per-pixel NDC depth.
    // Gaussians arrive pre-sorted by tile-center depth (global sort key).
    // The k-buffer corrects per-pixel ordering within that global order.
    // =================================================================

    // Per-pixel k-buffer: 4 sorted slots (ascending depth).
    // All private (per-thread) — no shared memory needed.
    const int HEAD_W = 4;
    float kbuf_depth[HEAD_W];
    float kbuf_alpha[HEAD_W];
    float kbuf_r[HEAD_W];
    float kbuf_g[HEAD_W];
    float kbuf_b[HEAD_W];
    int kbuf_size = 0;
    for (int i = 0; i < HEAD_W; i++) {
        kbuf_depth[i] = 1e30;
        kbuf_alpha[i] = 0.0;
        kbuf_r[i] = 0.0; kbuf_g[i] = 0.0; kbuf_b[i] = 0.0;
    }

    for (uint batch_start = range_start;
         batch_start < range_end;
         batch_start += BATCH_SIZE)
    {
        // 1. Cooperative load into shared memory.
        uint load_idx = batch_start + local_idx;
        if (load_idx < range_end) {
            uint gid = values_sorted[load_idx];
            s_gid[local_idx] = gid;
            for (int j = 0; j < 4; j++) {
                s_g2s[local_idx * 16u + uint(j)]       = gauss2screen[gid * 16u + 0u * 4u + uint(j)];
                s_g2s[local_idx * 16u + 4u + uint(j)]  = gauss2screen[gid * 16u + 1u * 4u + uint(j)];
                s_g2s[local_idx * 16u + 8u + uint(j)]  = gauss2screen[gid * 16u + 2u * 4u + uint(j)];
                s_g2s[local_idx * 16u + 12u + uint(j)] = gauss2screen[gid * 16u + 3u * 4u + uint(j)];
            }
            s_opa[local_idx]   = conic_opacity[gid * 4u + 3u];
            s_rgb_r[local_idx] = rgb[gid * 3u + 0u];
            s_rgb_g[local_idx] = rgb[gid * 3u + 1u];
            s_rgb_b[local_idx] = rgb[gid * 3u + 2u];
        }
        barrier();

        // 2. Per-pixel k-buffer insert for this batch.
        uint batch_size = min(BATCH_SIZE, range_end - batch_start);
        if (!pixel_done) {
            float fpx = float(pixel_x);
            float fpy = float(pixel_y);

            for (uint k = 0u; k < batch_size; ++k) {
                // Compute per-pixel plane equations.
                float plane_x[4], plane_y[4];
                for (int j = 0; j < 4; j++) {
                    plane_x[j] = s_g2s[k * 16u + uint(j)]      - s_g2s[k * 16u + 12u + uint(j)] * fpx;
                    plane_y[j] = s_g2s[k * 16u + 4u + uint(j)] - s_g2s[k * 16u + 12u + uint(j)] * fpy;
                }

                float max_pos[4];
                float power = -0.5 * maxContribRayPixel(plane_x, plane_y, max_pos);
                if (power > 0.0) continue;

                float alpha = min(0.99, s_opa[k] * exp(power));
                if (alpha < ALPHA_THRESHOLD) continue;

                // Depth clip.
                float w_ndc = 0.0, z_ndc = 0.0;
                for (int j = 0; j < 4; j++) {
                    w_ndc += s_g2s[k * 16u + 12u + uint(j)] * max_pos[j];
                    z_ndc += s_g2s[k * 16u + 8u + uint(j)]  * max_pos[j];
                }
                if (z_ndc < -w_ndc || z_ndc > w_ndc) continue;

                // Per-pixel depth for k-buffer sorting.
                // Use z_ndc + 8.0 (same +8 bias as scatter.comp; w_ndc is ~ constant per tile,
                // so z_ndc alone gives correct relative ordering within a tile's pre-sorted list).
                float sort_depth = z_ndc + 8.0;

                // If k-buffer full: blend the shallowest entry, pop it.
                if (kbuf_size == HEAD_W) {
                    float a0 = kbuf_alpha[0];
                    float test_T0 = T * (1.0 - a0);
                    if (test_T0 < T_MIN) { pixel_done = true; break; }
                    C.r += kbuf_r[0] * a0 * T;
                    C.g += kbuf_g[0] * a0 * T;
                    C.b += kbuf_b[0] * a0 * T;
                    T = test_T0; n += 1u;
                    for (int i = 1; i < HEAD_W; i++) {
                        kbuf_depth[i-1] = kbuf_depth[i]; kbuf_alpha[i-1] = kbuf_alpha[i];
                        kbuf_r[i-1] = kbuf_r[i]; kbuf_g[i-1] = kbuf_g[i]; kbuf_b[i-1] = kbuf_b[i];
                    }
                    kbuf_depth[HEAD_W-1] = 1e30; kbuf_size -= 1;
                }

                if (pixel_done) break;

                // Insertion-sort (ascending depth) into k-buffer.
                float id = sort_depth, ia = alpha;
                float ir = s_rgb_r[k], ig = s_rgb_g[k], ib = s_rgb_b[k];
                for (int i = 0; i < HEAD_W; i++) {
                    if (id < kbuf_depth[i]) {
                        float td = kbuf_depth[i]; kbuf_depth[i] = id; id = td;
                        float ta = kbuf_alpha[i]; kbuf_alpha[i] = ia; ia = ta;
                        float tr = kbuf_r[i]; kbuf_r[i] = ir; ir = tr;
                        float tg = kbuf_g[i]; kbuf_g[i] = ig; ig = tg;
                        float tb = kbuf_b[i]; kbuf_b[i] = ib; ib = tb;
                    }
                }
                kbuf_size += 1;
            }
        }
        barrier();
    }

    // Flush remaining k-buffer entries.
    if (!pixel_done) {
        for (int i = 0; i < HEAD_W; i++) {
            if (kbuf_size <= 0) break;
            float a0 = kbuf_alpha[0];
            float test_T0 = T * (1.0 - a0);
            if (test_T0 < T_MIN) { pixel_done = true; break; }
            C.r += kbuf_r[0] * a0 * T;
            C.g += kbuf_g[0] * a0 * T;
            C.b += kbuf_b[0] * a0 * T;
            T = test_T0; n += 1u;
            for (int j = 1; j < HEAD_W; j++) {
                kbuf_depth[j-1] = kbuf_depth[j]; kbuf_alpha[j-1] = kbuf_alpha[j];
                kbuf_r[j-1] = kbuf_r[j]; kbuf_g[j-1] = kbuf_g[j]; kbuf_b[j-1] = kbuf_b[j];
            }
            kbuf_depth[HEAD_W-1] = 1e30; kbuf_size -= 1;
        }
    }

    } else {
    // =================================================================
    // 2D conic path (unchanged from SP-2 — standard front-to-back blend).
    // =================================================================

    for (uint batch_start = range_start;
         batch_start < range_end;
         batch_start += BATCH_SIZE)
    {
        // 1. Cooperative load: each of 256 threads grabs one Gaussian if in range.
        uint load_idx = batch_start + local_idx;
        if (load_idx < range_end) {
            uint gid = values_sorted[load_idx];
            s_gid    [local_idx] = gid;
            s_mean_x [local_idx] = means2D      [gid * 2u + 0u];
            s_mean_y [local_idx] = means2D      [gid * 2u + 1u];
            s_conic_a[local_idx] = conic_opacity[gid * 4u + 0u];
            s_conic_b[local_idx] = conic_opacity[gid * 4u + 1u];
            s_conic_c[local_idx] = conic_opacity[gid * 4u + 2u];
            s_opacity[local_idx] = conic_opacity[gid * 4u + 3u];
            s_rgb_r  [local_idx] = rgb          [gid * 3u + 0u];
            s_rgb_g  [local_idx] = rgb          [gid * 3u + 1u];
            s_rgb_b  [local_idx] = rgb          [gid * 3u + 2u];
        }
        barrier();  // wait for all loads before any thread reads shared arrays

        // 2. Per-pixel alpha blend for this batch.
        uint batch_size = min(BATCH_SIZE, range_end - batch_start);
        if (!pixel_done) {
            for (uint k = 0u; k < batch_size; ++k) {
                float dx = float(pixel_x) - s_mean_x[k];
                float dy = float(pixel_y) - s_mean_y[k];
                float power = -0.5 * (s_conic_a[k] * dx * dx
                                    + s_conic_c[k] * dy * dy)
                              - s_conic_b[k] * dx * dy;
                if (power > 0.0) {
                    continue;
                }
                float alpha = min(0.99, s_opacity[k] * exp(power));
                if (alpha < ALPHA_THRESHOLD) {
                    continue;
                }
                float test_T = T * (1.0 - alpha);
                if (test_T < T_MIN) {
                    pixel_done = true;
                    break;
                }
                C.r += s_rgb_r[k] * alpha * T;
                C.g += s_rgb_g[k] * alpha * T;
                C.b += s_rgb_b[k] * alpha * T;
                T = test_T;
                n += 1u;
            }
        }
        barrier();
    }

    } // end spec_eval_3D branch

    // --- Write final outputs ---
    if (valid_pixel) {
        uint px = pixel_y * pc.image_width + pixel_x;
        uint HW = pc.image_width * pc.image_height;
        // Always composite against bg; for golden fixtures bg=(0,0,0,0).
        out_image[0u * HW + px] = C.r + T * bg_color.x;
        out_image[1u * HW + px] = C.g + T * bg_color.y;
        out_image[2u * HW + px] = C.b + T * bg_color.z;
        transmittance[px] = T;
        n_contrib[px]     = n;
    }
}
