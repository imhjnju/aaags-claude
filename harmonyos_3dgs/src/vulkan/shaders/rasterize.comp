#version 450

// SP-2 rasterize.comp — per-tile alpha blending (spec §4.8.7).
//
// One workgroup = one 16x16 tile. Each invocation = one pixel. The workgroup
// cooperatively loads batches of up to 256 Gaussians from the sorted list for
// its tile into shared memory, then every pixel-thread walks the batch in
// sort order and front-to-back alpha-blends Gaussians that cover it until
// transmittance T falls below a threshold or the tile's Gaussian list ends.
//
// CUDA reference: AAA-Gaussians/submodules/diff-gaussian-rasterization/
//   cuda_rasterizer/forward.cu: renderCUDA(...) — the algorithm we mirror.
//
// Bindings match rasterize_bind:: in include/vulkan/preprocess_bindings.h.
//
// NUMERICAL CONTRACTS (match CUDA bit-for-bit given identical inputs):
//   - alpha threshold    : ALPHA_THRESHOLD = 1.0 / 255.0
//   - T  (early-out)     : T_MIN           = 0.0001
//   - alpha cap          : min(0.99, opacity * exp(power))   (forward.cu:366)
//   - power              : -0.5*(a*dx^2 + c*dy^2) - b*dx*dy
//     Note: conic_opacity_packed[b] is the raw off-diagonal cov2D_inv[0][1],
//     NOT pre-halved. Formula matches forward.cu:
//       float power = -0.5f*(con_o.x*d.x*d.x + con_o.z*d.y*d.y)
//                     - con_o.y*d.x*d.y;
//   - power > 0 skip     : Gaussian evaluated behind its own peak — skip.
//   - n_contrib (2D path): CUDA-style 1-based position of the last Gaussian
//                          that actually blended in the tile traversal. Gaussians
//                          skipped by power/alpha still advance the position.
//   - output layout      : CHW. out_image[ch*H*W + y*W + x]  (channel-first, matches CUDA/PyTorch).
//   - background         : final color = C_accum + T_final * bg_color (always
//                          applied, even when bg is zero).
//
// Shared memory footprint (2D path):  10 arrays * 256 floats/uints = 10.24 KB.
// Shared memory footprint (eval_3D parity path): s_g2s (16 KB) + s_opa (1 KB)
//                                      + s_rgb_{r,g,b}+s_gid reused (4 KB).
// Production eval_3D uses private TAIL/MID/HEAD queues per pixel and no
// workgroup barriers in the replay stream.
//
// Synchronisation: barriers bracket cooperative loads only in paths that use
// shared batch caches; pixels whose tile has early-terminated still participate
// in those barriers so divergent pixel_done states don't hang the workgroup.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// binding 0 — sorted Gaussian indices (one per (Gaussian, tile) pair).
layout(std430, set = 0, binding = 0) readonly buffer ValuesSorted {
    uint values_sorted[];
};

// binding 1 — [start0, end0, start1, end1, ...] inclusive/exclusive per tile.
layout(std430, set = 0, binding = 1) readonly buffer TileRanges {
    uint tile_ranges[];
};

// binding 2 — means2D interleaved [x0,y0, x1,y1, ...].
layout(std430, set = 0, binding = 2) readonly buffer Means2D {
    float means2D[];
};

// binding 3 — packed [a, b, c, opacity] per Gaussian (stride 4 floats).
layout(std430, set = 0, binding = 3) readonly buffer ConicOpacity {
    float conic_opacity[];
};

// binding 4 — per-Gaussian RGB [r,g,b] interleaved (stride 3 floats).
layout(std430, set = 0, binding = 4) readonly buffer RGB {
    float rgb[];
};

// binding 5 — output image, CHW: [R-plane | G-plane | B-plane], each H*W.
layout(std430, set = 0, binding = 5) writeonly buffer OutImage {
    float out_image[];
};

// binding 6 — per-pixel final transmittance (H*W floats).
layout(std430, set = 0, binding = 6) writeonly buffer Transmittance {
    float transmittance[];
};

// binding 7 — per-pixel blended-Gaussian count (H*W uints).
layout(std430, set = 0, binding = 7) writeonly buffer NContrib {
    uint n_contrib[];
};

// binding 8 — background colour UBO (std140, 16 bytes).
layout(std140, set = 0, binding = 8) uniform RasterUBO {
    vec4 bg_color;  // (R, G, B, unused)
};

// eval_3D bindings (9..13) — only accessed when spec_eval_3D == 1.
layout(std430, set = 0, binding = 9)  readonly buffer Gauss2Screen { float gauss2screen[]; };  // [N*16] row-major
layout(std430, set = 0, binding = 10) readonly buffer Opacities2D  { float opacities_2d[]; };  // [N] pre-dilated opacity
layout(std430, set = 0, binding = 11) readonly buffer Cov3DInv     { float cov3D_inv[];    };  // [N*6] inverse 3D cov
layout(std430, set = 0, binding = 12) readonly buffer MeanOffset   { float mean_offset[];  };  // [N*3] (pos - cam_pos)
layout(std140, set = 0, binding = 13) uniform RasterEval3DUBO {
    mat4 inverse_vp;        // 64B: inverse viewproj (column-major)
    vec4 cam_pos_pad;       // 16B: xyz=cam_pos, w=0
    vec4 img_size_pad;      // 16B: x=width, y=height, z=0, w=0
} eval3d_ubo;

// Optional eval_3D non-parity exact-backward replay sideband. When
// eval3d_ubo.img_size_pad.z != 0, rasterize writes each blended Gaussian ID in
// the exact per-pixel forward order at replay_order_offsets[px] + local_count.
layout(std430, set = 0, binding = 14) readonly buffer ReplayOrderOffsets { uint replay_order_offsets[]; };
layout(std430, set = 0, binding = 15) writeonly buffer ReplayOrderGids { uint replay_order_gids[]; };

// Specialization constant: 0=2D conic path, 1=eval_3D k-buffer path.
layout(constant_id = 0) const uint spec_eval_3D = 0u;
// Specialization constant: when 1, skip the per-4x4 sub-tile re-sort inside the
// eval_3D path. HEAD then receives Gaussians in raw sorted-batch (tile-center
// depth) order — matches CUDA sort_mode=0 behaviour. Used by `parity_mode` for
// bit-level VK-vs-CUDA first-loss comparison. Default 0 (re-sort enabled).
layout(constant_id = 1) const uint spec_disable_subtile_resort = 0u;

// RasterizePushConstants — 20 bytes (spec §4.8.7).
layout(push_constant) uniform PC {
    uint num_gaussians;  // layout padding — kept to match RasterizePushConstants (spec §4.8.7)
    uint image_width;
    uint image_height;
    uint num_tiles_x;
    uint num_tiles_y;    // layout padding — kept to match RasterizePushConstants (spec §4.8.7)
} pc;

// --- Shared cache of the current batch (up to 256 Gaussians) ---
shared float s_mean_x [256];
shared float s_mean_y [256];
shared float s_conic_a[256];
shared float s_conic_b[256];
shared float s_conic_c[256];
shared float s_opacity[256];
shared float s_rgb_r  [256];
shared float s_rgb_g  [256];
shared float s_rgb_b  [256];
shared uint  s_gid    [256];

// eval_3D shared memory: gauss2screen all 4 rows (16 floats per Gaussian),
// opacity. s_rgb_r/g/b and s_gid are reused from 2D path.
// Total eval_3D: 16*256*4 + 1*256*4 + reused = ~17 KB + 4 KB reused.
shared float s_g2s  [256 * 16];  // all 4 rows of gauss2screen (need row 2 for depth)
shared float s_opa  [256];       // pre-dilated opacity (eval_3D)

// Production eval_3D replay follows CUDA StopThePop sort_mode=3 semantics:
// a 4x4 TAIL queue with frustum/alpha culling, a 2x2 MID queue, then a
// per-pixel HEAD queue. Evidence: spec/README.md §6 +
// investigations/l1b_raster_replay_order.md.
const int  TAIL_W           = 64;
const int  MID_W            = 8;
const int  HEAD_W           = 4;
const int  DRAIN_TAIL_COUNT = 16;
const int  CUDA_STAGE_W     = 32;

const float ALPHA_THRESHOLD = 1.0 / 255.0;  // forward.cu: alpha < 1/255
const float T_MIN           = 0.0001;       // forward.cu: test_T < 0.0001
const uint  BATCH_SIZE      = 256u;         // 16*16 pixels per tile.

bool replayOrderEnabled() {
    return eval3d_ubo.img_size_pad.z != 0.0;
}

void writeReplayOrder(uint px, uint local_slot, uint gid) {
    if (replayOrderEnabled()) {
        replay_order_gids[replay_order_offsets[px] + local_slot] = gid;
    }
}

bool beforeDepthOrder(float lhs_depth, uint lhs_order, float rhs_depth, uint rhs_order) {
    return (lhs_depth < rhs_depth) || (lhs_depth == rhs_depth && lhs_order < rhs_order);
}

bool finiteFloat(float v) {
    return !isnan(v) && !isinf(v);
}

float g2sAt(uint gid, uint row, uint col) {
    return gauss2screen[gid * 16u + row * 4u + col];
}

vec4 g2sRow(uint gid, uint row) {
    return vec4(g2sAt(gid, row, 0u), g2sAt(gid, row, 1u), g2sAt(gid, row, 2u), g2sAt(gid, row, 3u));
}

vec4 transformG2S(uint gid, vec4 p) {
    return vec4(dot(g2sRow(gid, 0u), p),
                dot(g2sRow(gid, 1u), p),
                dot(g2sRow(gid, 2u), p),
                dot(g2sRow(gid, 3u), p));
}

// --- eval_3D helper functions ------------------------------------------------

// Port of CUDA consistent_common.cuh:max_contrib_ray.
// Returns squared Mahalanobis distance (peak exponent) and sets max_pos to
// the closest-approach point on the ray (in Gaussian homogeneous coordinates).
// Caller uses max_pos with g2s rows 2,3 to compute NDC depth.
float maxContribRayPixel(float plane_a[4], float plane_b[4], out float max_pos[4]) {
    float dx = plane_a[1]*plane_b[2] - plane_a[2]*plane_b[1];
    float dy = plane_a[2]*plane_b[0] - plane_a[0]*plane_b[2];
    float dz = plane_a[0]*plane_b[1] - plane_a[1]*plane_b[0];
    float mx = plane_a[3]*plane_b[0] - plane_a[0]*plane_b[3];
    float my = plane_a[3]*plane_b[1] - plane_a[1]*plane_b[3];
    float mz = plane_a[3]*plane_b[2] - plane_a[2]*plane_b[3];
    float dd = dx*dx + dy*dy + dz*dz;
    if (dd < 1e-8) {
        max_pos = float[4](0.0, 0.0, 0.0, 1.0);
        return 0.0;
    }
    float m_div_dd[3] = float[3](mx/dd, my/dd, mz/dd);
    max_pos[0] = dy*m_div_dd[2] - dz*m_div_dd[1];
    max_pos[1] = dz*m_div_dd[0] - dx*m_div_dd[2];
    max_pos[2] = dx*m_div_dd[1] - dy*m_div_dd[0];
    max_pos[3] = 1.0;
    return mx*m_div_dd[0] + my*m_div_dd[1] + mz*m_div_dd[2];
}

bool maxContribRayVec(vec4 plane_a, vec4 plane_b, bool allow_degenerate_zero,
                      out float dist2, out vec4 max_pos) {
    float dx = plane_a.y * plane_b.z - plane_a.z * plane_b.y;
    float dy = plane_a.z * plane_b.x - plane_a.x * plane_b.z;
    float dz = plane_a.x * plane_b.y - plane_a.y * plane_b.x;
    float mx = plane_a.w * plane_b.x - plane_a.x * plane_b.w;
    float my = plane_a.w * plane_b.y - plane_a.y * plane_b.w;
    float mz = plane_a.w * plane_b.z - plane_a.z * plane_b.w;
    float dd = dx * dx + dy * dy + dz * dz;
    if (dd < 1e-8) {
        if (allow_degenerate_zero) {
            dist2 = 0.0;
            max_pos = vec4(0.0, 0.0, 0.0, 1.0);
            return true;
        }
        dist2 = 0.0;
        max_pos = vec4(0.0, 0.0, 0.0, 1.0);
        return false;
    }
    vec3 m_div_dd = vec3(mx / dd, my / dd, mz / dd);
    max_pos = vec4(dy * m_div_dd.z - dz * m_div_dd.y,
                   dz * m_div_dd.x - dx * m_div_dd.z,
                   dx * m_div_dd.y - dy * m_div_dd.x,
                   1.0);
    dist2 = mx * m_div_dd.x + my * m_div_dd.y + mz * m_div_dd.z;
    return true;
}

bool inScreenRangeDim(vec4 pos, vec3 range_from, vec3 extent, int dim, out float d) {
    d = pos[dim] - range_from[dim] * pos.w;
    return d > 0.0 && d < extent[dim] * pos.w;
}

bool maxContribPlaneScreen(uint gid, vec4 plane, out float contrib, out vec4 pos) {
    float n2 = dot(plane.xyz, plane.xyz);
    if (n2 <= 0.0) {
        contrib = 0.0;
        pos = vec4(0.0);
        return false;
    }
    float norm = plane.w / n2;
    vec4 pos_gauss = vec4(-plane.x * norm, -plane.y * norm, -plane.z * norm, 1.0);
    contrib = plane.w * norm;
    pos = transformG2S(gid, pos_gauss);
    return finiteFloat(contrib);
}

bool maxContribRayScreen(uint gid, vec4 plane_a, vec4 plane_b, out float contrib, out vec4 pos) {
    vec4 pos_gauss;
    if (!maxContribRayVec(plane_a, plane_b, false, contrib, pos_gauss)) {
        pos = vec4(0.0);
        return false;
    }
    pos = transformG2S(gid, pos_gauss);
    return finiteFloat(contrib);
}

void considerFrustumCandidate(inout float best, inout bool has_best,
                              float contrib, vec4 pos, bool ok_candidate,
                              vec3 range_from, vec3 extent,
                              bool check_x, bool check_y, bool check_z) {
    if (!ok_candidate || !finiteFloat(contrib)) return;
    float dtmp;
    if (check_x && !inScreenRangeDim(pos, range_from, extent, 0, dtmp)) return;
    if (check_y && !inScreenRangeDim(pos, range_from, extent, 1, dtmp)) return;
    if (check_z && !inScreenRangeDim(pos, range_from, extent, 2, dtmp)) return;
    if (!has_best || contrib < best) {
        best = contrib;
        has_best = true;
    }
}

float copySignHalf(float half_extent, float sign_source) {
    return sign_source < 0.0 ? -half_extent : half_extent;
}

float maxContribGaussianFrustum3D(uint gid, vec2 rect_min, vec2 rect_max) {
    vec3 range_from = vec3(rect_min.x, rect_min.y, -1.0);
    vec3 extent = vec3(rect_max.x - rect_min.x, rect_max.y - rect_min.y, 2.0);
    vec4 mean_screen = vec4(g2sAt(gid, 0u, 3u), g2sAt(gid, 1u, 3u),
                            g2sAt(gid, 2u, 3u), g2sAt(gid, 3u, 3u));

    float d_x, d_y, d_z;
    bool between_x = inScreenRangeDim(mean_screen, range_from, extent, 0, d_x);
    bool between_y = inScreenRangeDim(mean_screen, range_from, extent, 1, d_y);
    bool between_z = inScreenRangeDim(mean_screen, range_from, extent, 2, d_z);
    if (between_x && between_y && between_z) {
        return 0.0;
    }

    float dx = copySignHalf(0.5 * extent.x, d_x - 0.5 * extent.x * mean_screen.w);
    float dy = copySignHalf(0.5 * extent.y, d_y - 0.5 * extent.y * mean_screen.w);
    float cx = range_from.x + 0.5 * extent.x + dx;
    float cy = range_from.y + 0.5 * extent.y + dy;

    vec4 row0 = g2sRow(gid, 0u);
    vec4 row1 = g2sRow(gid, 1u);
    vec4 row3 = g2sRow(gid, 3u);
    vec4 closer_plane_x = row0 - row3 * cx;
    vec4 closer_plane_y = row1 - row3 * cy;
    float best = 0.0;
    bool has_best = false;
    float contrib;
    vec4 pos;

    bool ok = maxContribPlaneScreen(gid, closer_plane_x, contrib, pos);
    considerFrustumCandidate(best, has_best, contrib, pos, ok, range_from, extent, false, true, true);
    ok = maxContribPlaneScreen(gid, closer_plane_y, contrib, pos);
    considerFrustumCandidate(best, has_best, contrib, pos, ok, range_from, extent, true, false, true);
    ok = maxContribRayScreen(gid, closer_plane_x, closer_plane_y, contrib, pos);
    considerFrustumCandidate(best, has_best, contrib, pos, ok, range_from, extent, false, false, true);

    vec4 other_plane_y = row1 - row3 * (range_from.y + 0.5 * extent.y - dy);
    ok = maxContribRayScreen(gid, closer_plane_x, other_plane_y, contrib, pos);
    considerFrustumCandidate(best, has_best, contrib, pos, ok, range_from, extent, false, false, true);

    vec4 other_plane_x = row0 - row3 * (range_from.x + 0.5 * extent.x - dx);
    ok = maxContribRayScreen(gid, other_plane_x, closer_plane_y, contrib, pos);
    considerFrustumCandidate(best, has_best, contrib, pos, ok, range_from, extent, false, false, true);

    if (!has_best) return 3.402823466e+38;
    return 0.5 * best;
}

bool passesTailFrustumAlpha(uint gid, vec2 rect_min, vec2 rect_max) {
    float factor = maxContribGaussianFrustum3D(gid, rect_min, rect_max);
    if (!finiteFloat(factor)) return false;
    float alpha = min(0.99, conic_opacity[gid * 4u + 3u] * exp(-factor));
    return alpha >= ALPHA_THRESHOLD;
}

float sortDepthAtGid(uint gid, float x, float y) {
    vec4 plane_x = g2sRow(gid, 0u) - g2sRow(gid, 3u) * x;
    vec4 plane_y = g2sRow(gid, 1u) - g2sRow(gid, 3u) * y;
    float dist2;
    vec4 max_pos;
    maxContribRayVec(plane_x, plane_y, true, dist2, max_pos);
    float w_ndc = dot(g2sRow(gid, 3u), max_pos);
    float z_ndc = dot(g2sRow(gid, 2u), max_pos);
    return w_ndc > 1e-6 ? z_ndc / w_ndc : z_ndc;
}

struct PixelEval3D {
    bool valid;
    float depth;
    float alpha;
    vec3 color;
};

PixelEval3D evalPixelGid(uint gid, float x, float y) {
    PixelEval3D ev;
    ev.valid = false;
    ev.depth = 0.0;
    ev.alpha = 0.0;
    ev.color = vec3(0.0);

    vec4 plane_x = g2sRow(gid, 0u) - g2sRow(gid, 3u) * x;
    vec4 plane_y = g2sRow(gid, 1u) - g2sRow(gid, 3u) * y;
    float dist2;
    vec4 max_pos;
    maxContribRayVec(plane_x, plane_y, true, dist2, max_pos);
    float power = -0.5 * dist2;
    if (power > 0.0) return ev;

    float alpha = min(0.99, conic_opacity[gid * 4u + 3u] * exp(power));
    if (alpha < ALPHA_THRESHOLD) return ev;

    float w_ndc = dot(g2sRow(gid, 3u), max_pos);
    float z_ndc = dot(g2sRow(gid, 2u), max_pos);
    if (z_ndc < -w_ndc || z_ndc > w_ndc) return ev;

    ev.valid = true;
    ev.depth = w_ndc > 1e-6 ? z_ndc / w_ndc : z_ndc;
    ev.alpha = alpha;
    ev.color = vec3(rgb[gid * 3u + 0u], rgb[gid * 3u + 1u], rgb[gid * 3u + 2u]);
    return ev;
}

void insertTailItem(inout float depths[TAIL_W], inout uint gids[TAIL_W], inout uint orders[TAIL_W],
                    inout int count, float depth, uint gid, uint order) {
    int pos = count;
    for (int i = 0; i < TAIL_W; ++i) {
        if (i >= count) break;
        if (beforeDepthOrder(depth, order, depths[i], orders[i])) {
            pos = i;
            break;
        }
    }
    if (count == TAIL_W && pos == count) return;
    int max_i = min(count, TAIL_W - 1);
    for (int i = TAIL_W - 1; i > 0; --i) {
        if (i > pos && i <= max_i) {
            depths[i] = depths[i - 1];
            gids[i] = gids[i - 1];
            orders[i] = orders[i - 1];
        }
    }
    depths[pos] = depth;
    gids[pos] = gid;
    orders[pos] = order;
    count = min(count + 1, TAIL_W);
}

void insertGroupItem(inout float depths[4], inout uint gids[4], inout uint orders[4],
                     inout int count, float depth, uint gid, uint order) {
    int pos = count;
    for (int i = 0; i < 4; ++i) {
        if (i >= count) break;
        if (beforeDepthOrder(depth, order, depths[i], orders[i])) {
            pos = i;
            break;
        }
    }
    for (int i = 3; i > 0; --i) {
        if (i > pos && i <= count) {
            depths[i] = depths[i - 1];
            gids[i] = gids[i - 1];
            orders[i] = orders[i - 1];
        }
    }
    depths[pos] = depth;
    gids[pos] = gid;
    orders[pos] = order;
    count = min(count + 1, 4);
}

void insertMidItem(inout float depths[MID_W], inout uint gids[MID_W], inout uint orders[MID_W],
                   inout int count, float depth, uint gid, uint order) {
    int pos = count;
    for (int i = 0; i < MID_W; ++i) {
        if (i >= count) break;
        if (beforeDepthOrder(depth, order, depths[i], orders[i])) {
            pos = i;
            break;
        }
    }
    if (count == MID_W && pos == count) return;
    int max_i = min(count, MID_W - 1);
    for (int i = MID_W - 1; i > 0; --i) {
        if (i > pos && i <= max_i) {
            depths[i] = depths[i - 1];
            gids[i] = gids[i - 1];
            orders[i] = orders[i - 1];
        }
    }
    depths[pos] = depth;
    gids[pos] = gid;
    orders[pos] = order;
    count = min(count + 1, MID_W);
}

void pushHeadItem(uint gid, uint order, float depth, float alpha, vec3 color,
                  inout float depths[HEAD_W], inout float alphas[HEAD_W],
                  inout vec3 colors[HEAD_W], inout uint gids[HEAD_W], inout uint orders[HEAD_W],
                  inout int count, inout float T, inout vec3 C, inout uint n,
                  uint px_linear, inout bool pixel_done) {
    if (pixel_done) return;
    if (count == HEAD_W) {
        float test_T = T * (1.0 - alphas[0]);
        if (test_T < T_MIN) {
            pixel_done = true;
            return;
        }
        C += colors[0] * alphas[0] * T;
        writeReplayOrder(px_linear, n, gids[0]);
        T = test_T;
        n += 1u;
        for (int i = 1; i < HEAD_W; ++i) {
            depths[i - 1] = depths[i];
            alphas[i - 1] = alphas[i];
            colors[i - 1] = colors[i];
            gids[i - 1] = gids[i];
            orders[i - 1] = orders[i];
        }
        depths[HEAD_W - 1] = 1e30;
        alphas[HEAD_W - 1] = 0.0;
        colors[HEAD_W - 1] = vec3(0.0);
        gids[HEAD_W - 1] = 0u;
        orders[HEAD_W - 1] = 0u;
        count -= 1;
    }

    int pos = count;
    for (int i = 0; i < HEAD_W; ++i) {
        if (i >= count) break;
        if (beforeDepthOrder(depth, order, depths[i], orders[i])) {
            pos = i;
            break;
        }
    }
    for (int i = HEAD_W - 1; i > 0; --i) {
        if (i > pos && i <= count) {
            depths[i] = depths[i - 1];
            alphas[i] = alphas[i - 1];
            colors[i] = colors[i - 1];
            gids[i] = gids[i - 1];
            orders[i] = orders[i - 1];
        }
    }
    depths[pos] = depth;
    alphas[pos] = alpha;
    colors[pos] = color;
    gids[pos] = gid;
    orders[pos] = order;
    count += 1;
}

void emitMidFront(uint emit_count,
                  inout float mid_depths[MID_W], inout uint mid_gids[MID_W], inout uint mid_orders[MID_W],
                  inout int mid_count,
                  inout float head_depths[HEAD_W], inout float head_alphas[HEAD_W],
                  inout vec3 head_colors[HEAD_W], inout uint head_gids[HEAD_W], inout uint head_orders[HEAD_W],
                  inout int head_count, float fpx, float fpy,
                  inout float T, inout vec3 C, inout uint n, uint px_linear, inout bool pixel_done) {
    for (uint i = 0u; i < emit_count; ++i) {
        if (pixel_done) return;
        PixelEval3D ev = evalPixelGid(mid_gids[i], fpx, fpy);
        if (ev.valid) {
            pushHeadItem(mid_gids[i], mid_orders[i], ev.depth, ev.alpha, ev.color,
                         head_depths, head_alphas, head_colors, head_gids, head_orders,
                         head_count, T, C, n, px_linear, pixel_done);
        }
    }
    for (int i = 0; i < MID_W; ++i) {
        int src = i + int(emit_count);
        if (src < mid_count) {
            mid_depths[i] = mid_depths[src];
            mid_gids[i] = mid_gids[src];
            mid_orders[i] = mid_orders[src];
        } else {
            mid_depths[i] = 1e30;
            mid_gids[i] = 0u;
            mid_orders[i] = 0u;
        }
    }
    mid_count -= int(emit_count);
}

void pushMidGroup(float group_depths[4], uint group_gids[4], uint group_orders[4], int group_count,
                  inout float mid_depths[MID_W], inout uint mid_gids[MID_W], inout uint mid_orders[MID_W],
                  inout int mid_count,
                  inout float head_depths[HEAD_W], inout float head_alphas[HEAD_W],
                  inout vec3 head_colors[HEAD_W], inout uint head_gids[HEAD_W], inout uint head_orders[HEAD_W],
                  inout int head_count, float fpx, float fpy,
                  inout float T, inout vec3 C, inout uint n, uint px_linear, inout bool pixel_done) {
    if (group_count <= 0 || pixel_done) return;
    if (mid_count == 0) {
        for (int i = 0; i < 4; ++i) {
            if (i < group_count) {
                mid_depths[i] = group_depths[i];
                mid_gids[i] = group_gids[i];
                mid_orders[i] = group_orders[i];
            }
        }
        mid_count = group_count;
        return;
    }

    float merged_depths[MID_W];
    uint merged_gids[MID_W];
    uint merged_orders[MID_W];
    int merged_count = 0;
    for (int i = 0; i < MID_W; ++i) {
        if (i < mid_count) {
            insertMidItem(merged_depths, merged_gids, merged_orders, merged_count,
                           mid_depths[i], mid_gids[i], mid_orders[i]);
        }
    }
    for (int i = 0; i < 4; ++i) {
        if (i < group_count) {
            insertMidItem(merged_depths, merged_gids, merged_orders, merged_count,
                           group_depths[i], group_gids[i], group_orders[i]);
        }
    }
    for (int i = 0; i < MID_W; ++i) {
        if (i < merged_count) {
            mid_depths[i] = merged_depths[i];
            mid_gids[i] = merged_gids[i];
            mid_orders[i] = merged_orders[i];
        } else {
            mid_depths[i] = 1e30;
            mid_gids[i] = 0u;
            mid_orders[i] = 0u;
        }
    }
    mid_count = merged_count;
    emitMidFront(uint(min(4, mid_count)), mid_depths, mid_gids, mid_orders, mid_count,
                 head_depths, head_alphas, head_colors, head_gids, head_orders,
                 head_count, fpx, fpy, T, C, n, px_linear, pixel_done);
}

void main() {
    // --- Tile → range lookup ---
    uint tile_id = gl_WorkGroupID.y * pc.num_tiles_x + gl_WorkGroupID.x;
    uint range_start = tile_ranges[tile_id * 2u + 0u];
    uint range_end   = tile_ranges[tile_id * 2u + 1u];

    // --- Per-pixel coordinates ---
    uint pixel_x = gl_WorkGroupID.x * 16u + gl_LocalInvocationID.x;
    uint pixel_y = gl_WorkGroupID.y * 16u + gl_LocalInvocationID.y;
    bool valid_pixel = (pixel_x < pc.image_width) && (pixel_y < pc.image_height);

    // Linear index into shared cache for cooperative loads (0..255).
    uint local_idx = gl_LocalInvocationIndex;

    // Per-pixel accumulators.
    float T = 1.0;
    vec3  C = vec3(0.0);
    uint  n = 0u;
    uint  contributor_pos = 0u;
    uint  px_linear = pixel_y * pc.image_width + pixel_x;
    // Pixels outside the image still participate in cooperative loads/barriers
    // but contribute nothing; treat them as already-done for the blending loop.
    bool pixel_done = !valid_pixel;

    if (spec_eval_3D == 1u) {
    // =================================================================
    // eval_3D path.
    //
    // Parity mode preserves raw tile order. Production mode follows CUDA's
    // StopThePop TAIL→MID→HEAD replay cascade with 4x4 frustum/alpha culling.
    // =================================================================

    if (spec_disable_subtile_resort == 1u) {
        for (uint batch_start = range_start;
             batch_start < range_end;
             batch_start += BATCH_SIZE)
        {
            uint load_idx = batch_start + local_idx;
            if (load_idx < range_end) {
                uint gid = values_sorted[load_idx];
                s_gid[local_idx] = gid;
                for (int j = 0; j < 4; j++) {
                    s_g2s[local_idx * 16u + uint(j)]       = gauss2screen[gid * 16u + 0u * 4u + uint(j)];
                    s_g2s[local_idx * 16u + 4u + uint(j)]  = gauss2screen[gid * 16u + 1u * 4u + uint(j)];
                    s_g2s[local_idx * 16u + 8u + uint(j)]  = gauss2screen[gid * 16u + 2u * 4u + uint(j)];
                    s_g2s[local_idx * 16u + 12u + uint(j)] = gauss2screen[gid * 16u + 3u * 4u + uint(j)];
                }
                s_opa[local_idx]   = conic_opacity[gid * 4u + 3u];
                s_rgb_r[local_idx] = rgb[gid * 3u + 0u];
                s_rgb_g[local_idx] = rgb[gid * 3u + 1u];
                s_rgb_b[local_idx] = rgb[gid * 3u + 2u];
            }
            barrier();

            uint batch_size = min(BATCH_SIZE, range_end - batch_start);
            if (!pixel_done) {
                float fpx = float(pixel_x);
                float fpy = float(pixel_y);
                for (uint k = 0u; k < batch_size; ++k) {
                    contributor_pos += 1u;

                    float plane_x[4], plane_y[4];
                    for (int j = 0; j < 4; j++) {
                        plane_x[j] = s_g2s[k * 16u + uint(j)]      - s_g2s[k * 16u + 12u + uint(j)] * fpx;
                        plane_y[j] = s_g2s[k * 16u + 4u + uint(j)] - s_g2s[k * 16u + 12u + uint(j)] * fpy;
                    }

                    float max_pos[4];
                    float power = -0.5 * maxContribRayPixel(plane_x, plane_y, max_pos);
                    if (power > 0.0) continue;

                    float alpha = min(0.99, s_opa[k] * exp(power));
                    if (alpha < ALPHA_THRESHOLD) continue;

                    float w_ndc = 0.0, z_ndc = 0.0;
                    for (int j = 0; j < 4; j++) {
                        w_ndc += s_g2s[k * 16u + 12u + uint(j)] * max_pos[j];
                        z_ndc += s_g2s[k * 16u + 8u + uint(j)]  * max_pos[j];
                    }
                    if (z_ndc < -w_ndc || z_ndc > w_ndc) continue;

                    float test_T = T * (1.0 - alpha);
                    if (test_T < T_MIN) {
                        pixel_done = true;
                        break;
                    }
                    C.r += s_rgb_r[k] * alpha * T;
                    C.g += s_rgb_g[k] * alpha * T;
                    C.b += s_rgb_b[k] * alpha * T;
                    T = test_T;
                    n = contributor_pos;
                }
            }
            barrier();
        }
    } else {

    float fpx = float(pixel_x);
    float fpy = float(pixel_y);
    uint stx = gl_LocalInvocationID.x / 4u;
    uint sty = gl_LocalInvocationID.y / 4u;
    uint quad_x = (gl_LocalInvocationID.x % 4u) / 2u;
    uint quad_y = (gl_LocalInvocationID.y % 4u) / 2u;
    float tail_base_x = float(gl_WorkGroupID.x * 16u + 4u * stx);
    float tail_base_y = float(gl_WorkGroupID.y * 16u + 4u * sty);
    float tail_px = tail_base_x + 2.0;
    float tail_py = tail_base_y + 2.0;
    float mid_px = tail_base_x + 1.0 + 2.0 * float(quad_x);
    float mid_py = tail_base_y + 1.0 + 2.0 * float(quad_y);
    vec2 rect_min = vec2(tail_base_x, tail_base_y);
    vec2 rect_max = vec2(tail_base_x + 3.0, tail_base_y + 3.0);

    float tail_depths[TAIL_W];
    uint tail_gids[TAIL_W];
    uint tail_orders[TAIL_W];
    int tail_count = 0;
    float mid_depths[MID_W];
    uint mid_gids[MID_W];
    uint mid_orders[MID_W];
    int mid_count = 0;
    float head_depths[HEAD_W];
    float head_alphas[HEAD_W];
    vec3 head_colors[HEAD_W];
    uint head_gids[HEAD_W];
    uint head_orders[HEAD_W];
    int head_count = 0;
    for (int i = 0; i < TAIL_W; ++i) {
        tail_depths[i] = 1e30;
        tail_gids[i] = 0u;
        tail_orders[i] = 0u;
    }
    for (int i = 0; i < MID_W; ++i) {
        mid_depths[i] = 1e30;
        mid_gids[i] = 0u;
        mid_orders[i] = 0u;
    }
    for (int i = 0; i < HEAD_W; ++i) {
        head_depths[i] = 1e30;
        head_alphas[i] = 0.0;
        head_colors[i] = vec3(0.0);
        head_gids[i] = 0u;
        head_orders[i] = 0u;
    }

    uint order_idx = 0u;
    for (uint stage_start = range_start; stage_start < range_end && !pixel_done; stage_start += uint(CUDA_STAGE_W)) {
        uint stage_end = min(stage_start + uint(CUDA_STAGE_W), range_end);
        for (uint idx = stage_start; idx < stage_end; ++idx) {
            uint gid = values_sorted[idx];
            if (passesTailFrustumAlpha(gid, rect_min, rect_max)) {
                float d = sortDepthAtGid(gid, tail_px, tail_py);
                if (finiteFloat(d)) {
                    insertTailItem(tail_depths, tail_gids, tail_orders, tail_count, d, gid, order_idx);
                }
            }
            order_idx += 1u;
        }

        while (tail_count > CUDA_STAGE_W && !pixel_done) {
            for (int chunk_base = 0; chunk_base < DRAIN_TAIL_COUNT && !pixel_done; chunk_base += 4) {
                float group_depths[4];
                uint group_gids[4];
                uint group_orders[4];
                int group_count = 0;
                for (int j = 0; j < 4; ++j) {
                    int src = chunk_base + j;
                    if (src < tail_count) {
                        uint gid = tail_gids[src];
                        float d = sortDepthAtGid(gid, mid_px, mid_py);
                        if (finiteFloat(d)) {
                            insertGroupItem(group_depths, group_gids, group_orders, group_count,
                                            d, gid, tail_orders[src]);
                        }
                    }
                }
                pushMidGroup(group_depths, group_gids, group_orders, group_count,
                             mid_depths, mid_gids, mid_orders, mid_count,
                             head_depths, head_alphas, head_colors, head_gids, head_orders,
                             head_count, fpx, fpy, T, C, n, px_linear, pixel_done);
            }
            for (int i = 0; i < TAIL_W; ++i) {
                int src = i + DRAIN_TAIL_COUNT;
                if (src < tail_count) {
                    tail_depths[i] = tail_depths[src];
                    tail_gids[i] = tail_gids[src];
                    tail_orders[i] = tail_orders[src];
                } else {
                    tail_depths[i] = 1e30;
                    tail_gids[i] = 0u;
                    tail_orders[i] = 0u;
                }
            }
            tail_count -= DRAIN_TAIL_COUNT;
        }
    }

    while (tail_count > 0 && !pixel_done) {
        int chunk_count = min(DRAIN_TAIL_COUNT, tail_count);
        for (int chunk_base = 0; chunk_base < DRAIN_TAIL_COUNT && !pixel_done; chunk_base += 4) {
            float group_depths[4];
            uint group_gids[4];
            uint group_orders[4];
            int group_count = 0;
            for (int j = 0; j < 4; ++j) {
                int src = chunk_base + j;
                if (src < chunk_count) {
                    uint gid = tail_gids[src];
                    float d = sortDepthAtGid(gid, mid_px, mid_py);
                    if (finiteFloat(d)) {
                        insertGroupItem(group_depths, group_gids, group_orders, group_count,
                                        d, gid, tail_orders[src]);
                    }
                }
            }
            pushMidGroup(group_depths, group_gids, group_orders, group_count,
                         mid_depths, mid_gids, mid_orders, mid_count,
                         head_depths, head_alphas, head_colors, head_gids, head_orders,
                         head_count, fpx, fpy, T, C, n, px_linear, pixel_done);
        }
        for (int i = 0; i < TAIL_W; ++i) {
            int src = i + chunk_count;
            if (src < tail_count) {
                tail_depths[i] = tail_depths[src];
                tail_gids[i] = tail_gids[src];
                tail_orders[i] = tail_orders[src];
            } else {
                tail_depths[i] = 1e30;
                tail_gids[i] = 0u;
                tail_orders[i] = 0u;
            }
        }
        tail_count -= chunk_count;
    }

    if (mid_count > 0 && !pixel_done) {
        emitMidFront(uint(mid_count), mid_depths, mid_gids, mid_orders, mid_count,
                     head_depths, head_alphas, head_colors, head_gids, head_orders,
                     head_count, fpx, fpy, T, C, n, px_linear, pixel_done);
    }

    while (head_count > 0 && !pixel_done) {
        float test_T = T * (1.0 - head_alphas[0]);
        if (test_T < T_MIN) {
            pixel_done = true;
            break;
        }
        C += head_colors[0] * head_alphas[0] * T;
        writeReplayOrder(px_linear, n, head_gids[0]);
        T = test_T;
        n += 1u;
        for (int i = 1; i < HEAD_W; ++i) {
            head_depths[i - 1] = head_depths[i];
            head_alphas[i - 1] = head_alphas[i];
            head_colors[i - 1] = head_colors[i];
            head_gids[i - 1] = head_gids[i];
            head_orders[i - 1] = head_orders[i];
        }
        head_depths[HEAD_W - 1] = 1e30;
        head_alphas[HEAD_W - 1] = 0.0;
        head_colors[HEAD_W - 1] = vec3(0.0);
        head_gids[HEAD_W - 1] = 0u;
        head_orders[HEAD_W - 1] = 0u;
        head_count -= 1;
    }

    }

    } else {
    // =================================================================
    // 2D conic path (unchanged from SP-2 — standard front-to-back blend).
    // =================================================================

    for (uint batch_start = range_start;
         batch_start < range_end;
         batch_start += BATCH_SIZE)
    {
        // 1. Cooperative load: each of 256 threads grabs one Gaussian if in range.
        uint load_idx = batch_start + local_idx;
        if (load_idx < range_end) {
            uint gid = values_sorted[load_idx];
            s_gid    [local_idx] = gid;
            s_mean_x [local_idx] = means2D      [gid * 2u + 0u];
            s_mean_y [local_idx] = means2D      [gid * 2u + 1u];
            s_conic_a[local_idx] = conic_opacity[gid * 4u + 0u];
            s_conic_b[local_idx] = conic_opacity[gid * 4u + 1u];
            s_conic_c[local_idx] = conic_opacity[gid * 4u + 2u];
            s_opacity[local_idx] = conic_opacity[gid * 4u + 3u];
            s_rgb_r  [local_idx] = rgb          [gid * 3u + 0u];
            s_rgb_g  [local_idx] = rgb          [gid * 3u + 1u];
            s_rgb_b  [local_idx] = rgb          [gid * 3u + 2u];
        }
        barrier();  // wait for all loads before any thread reads shared arrays

        // 2. Per-pixel alpha blend for this batch.
        uint batch_size = min(BATCH_SIZE, range_end - batch_start);
        if (!pixel_done) {
            for (uint k = 0u; k < batch_size; ++k) {
                contributor_pos += 1u;
                float dx = float(pixel_x) - s_mean_x[k];
                float dy = float(pixel_y) - s_mean_y[k];
                float power = -0.5 * (s_conic_a[k] * dx * dx
                                    + s_conic_c[k] * dy * dy)
                              - s_conic_b[k] * dx * dy;
                if (power > 0.0) {
                    continue;
                }
                float alpha = min(0.99, s_opacity[k] * exp(power));
                if (alpha < ALPHA_THRESHOLD) {
                    continue;
                }
                float test_T = T * (1.0 - alpha);
                if (test_T < T_MIN) {
                    pixel_done = true;
                    break;
                }
                C.r += s_rgb_r[k] * alpha * T;
                C.g += s_rgb_g[k] * alpha * T;
                C.b += s_rgb_b[k] * alpha * T;
                T = test_T;
                n = contributor_pos;
            }
        }
        barrier();
    }

    } // end spec_eval_3D branch

    // --- Write final outputs ---
    if (valid_pixel) {
        uint px = pixel_y * pc.image_width + pixel_x;
        uint HW = pc.image_width * pc.image_height;
        // Always composite against bg; for golden fixtures bg=(0,0,0,0).
        out_image[0u * HW + px] = C.r + T * bg_color.x;
        out_image[1u * HW + px] = C.g + T * bg_color.y;
        out_image[2u * HW + px] = C.b + T * bg_color.z;
        transmittance[px] = T;
        n_contrib[px]     = n;
    }
}
