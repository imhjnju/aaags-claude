#version 450

#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer KeyvalsSorted {
    uint64_t keyvals_sorted[];
};

layout(std430, set = 0, binding = 1) writeonly buffer ValuesSorted {
    uint values_sorted[];
};

layout(std430, set = 0, binding = 2) buffer TileRanges {
    uint tile_ranges[];
};

layout(push_constant) uniform Push {
    uint num_elements;
    uint num_tiles;
    uint _pad0;
    uint _pad1;
} pc;

uint ceil_log2_u32(uint x) {
    uint bits = 0u;
    uint v = x - 1u;
    while (v > 0u) {
        bits += 1u;
        v >>= 1u;
    }
    return max(bits, 1u);
}

uint low_mask(uint bits) {
    return bits >= 32u ? 0xFFFFFFFFu : ((1u << bits) - 1u);
}

uint idx_bits_for_num_tiles() {
    return 64u - 32u - ceil_log2_u32(pc.num_tiles);
}

uint tile_of(uint64_t kv) {
    uint idx_bits = idx_bits_for_num_tiles();
    return uint(kv >> (32u + idx_bits));
}

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.num_elements) return;

    const uint64_t kv = keyvals_sorted[i];
    const uint tile = tile_of(kv);
    values_sorted[i] = uint(kv) & low_mask(idx_bits_for_num_tiles());

    if (tile >= pc.num_tiles) return;

    const bool is_start = (i == 0u) || (tile_of(keyvals_sorted[i - 1u]) != tile);
    const bool is_end = (i + 1u == pc.num_elements) || (tile_of(keyvals_sorted[i + 1u]) != tile);

    if (is_start) tile_ranges[tile * 2u] = i;
    if (is_end) tile_ranges[tile * 2u + 1u] = i + 1u;
}
