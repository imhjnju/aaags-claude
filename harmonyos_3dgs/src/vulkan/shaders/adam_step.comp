#version 450
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set=0, binding=0) buffer Params { float params[]; };
layout(std430, set=0, binding=1) readonly buffer Grad { float grad[]; };
layout(std430, set=0, binding=2) buffer M { float m[]; };
layout(std430, set=0, binding=3) buffer V { float v[]; };

layout(std140, set=0, binding=4) uniform AdamStepUBO {
    float beta1;
    float beta2;
    float eps;
    float lr;
    uint  n;
    uint  step;
    float _pad0;
    float _pad1;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) return;
    float g = grad[i];
    float mi = beta1 * m[i] + (1.0 - beta1) * g;
    float vi = beta2 * v[i] + (1.0 - beta2) * g * g;
    m[i] = mi;
    v[i] = vi;
    float bc1 = 1.0 - pow(beta1, float(step));
    float bc2 = 1.0 - pow(beta2, float(step));
    params[i] -= lr * (mi / bc1) / (sqrt(vi / bc2) + eps);
}
