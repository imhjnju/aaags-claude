#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Hx { float hx[]; };
layout(std430, set = 0, binding = 1) readonly buffer Mu2 { float mu2[]; };
layout(std430, set = 0, binding = 2) readonly buffer Hx2 { float hx2[]; };
layout(std430, set = 0, binding = 3) readonly buffer E2y { float e2y_cached[]; };
layout(std430, set = 0, binding = 4) readonly buffer Hxy { float hxy[]; };
layout(std430, set = 0, binding = 5) readonly buffer Rendered { float rendered[]; };
layout(std430, set = 0, binding = 6) readonly buffer Target { float target[]; };
layout(std430, set = 0, binding = 7) buffer DLDpixels { float dL_dpixels[]; };
layout(std430, set = 0, binding = 8) buffer Partials { float partials[]; };
layout(std430, set = 0, binding = 9) buffer Alpha { float alpha[]; };
layout(std430, set = 0, binding = 10) buffer Beta { float beta[]; };
layout(std430, set = 0, binding = 11) buffer Gamma { float gamma[]; };

layout(push_constant) uniform PC {
    uint W;
    uint H;
    uint num_elements;
    float lambda_dssim;
} pc;

const float K[11] = float[11](
    0.0010283801,
    0.0075987581,
    0.0360007721,
    0.1093606895,
    0.2130055377,
    0.2660117249,
    0.2130055377,
    0.1093606895,
    0.0360007721,
    0.0075987581,
    0.0010283801);
const float C1 = 0.0001;
const float C2 = 0.0009;

shared float local_loss[256];

uint clamp_u(int v, uint hi) {
    return uint(clamp(v, 0, int(hi)));
}

void main() {
    uint local_id = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    float partial = 0.0;

    if (gid < pc.num_elements) {
        uint HW = pc.W * pc.H;
        uint ch = gid / HW;
        uint p = gid - ch * HW;
        uint xpix = p % pc.W;
        uint ypix = p / pc.W;
        uint base = ch * HW;

        float m1 = 0.0;
        float e2x = 0.0;
        float exyv = 0.0;
        if (ypix >= 5u && ypix + 5u < pc.H) {
            for (int dy = -5; dy <= 5; ++dy) {
                uint idx = base + (ypix + uint(dy + 5) - 5u) * pc.W + xpix;
                float w = K[dy + 5];
                m1 += w * hx[idx];
                e2x += w * hx2[idx];
                exyv += w * hxy[idx];
            }
        } else {
            for (int dy = -5; dy <= 5; ++dy) {
                uint yy = clamp_u(int(ypix) + dy, pc.H - 1u);
                uint idx = base + yy * pc.W + xpix;
                float w = K[dy + 5];
                m1 += w * hx[idx];
                e2x += w * hx2[idx];
                exyv += w * hxy[idx];
            }
        }

        float m2 = mu2[gid];
        float ey2 = e2y_cached[gid];
        float x = rendered[gid];
        float y = target[gid];
        float d = x - y;
        float invN = 1.0 / float(pc.num_elements);
        float w_l1 = 1.0 - pc.lambda_dssim;
        float w_ssim = pc.lambda_dssim;
        dL_dpixels[gid] = w_l1 * (d > 0.0 ? invN : (d < 0.0 ? -invN : 0.0));

        float s1sq = e2x - m1 * m1;
        float s2sq = ey2 - m2 * m2;
        float s12 = exyv - m1 * m2;
        float A = 2.0 * m1 * m2 + C1;
        float B = 2.0 * s12 + C2;
        float D = m1 * m1 + m2 * m2 + C1;
        float E = s1sq + s2sq + C2;
        float ssim_val = A * B / (D * E);
        float inv_de = 1.0 / (D * E);
        float beta_v = 2.0 * A * inv_de;
        float gamma_v = -2.0 * ssim_val / E;
        beta[gid] = beta_v;
        gamma[gid] = gamma_v;
        alpha[gid] = 2.0 * m2 * B * inv_de
                   - 2.0 * ssim_val * m1 / D
                   - beta_v * m2
                   - gamma_v * m1;
        partial = w_l1 * abs(d) * invN - w_ssim * ssim_val * invN;
    }

    local_loss[local_id] = partial;
    barrier();
    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (local_id < stride) {
            local_loss[local_id] += local_loss[local_id + stride];
        }
        barrier();
    }
    if (local_id == 0u) {
        partials[gl_WorkGroupID.x] = local_loss[0];
    }
}
