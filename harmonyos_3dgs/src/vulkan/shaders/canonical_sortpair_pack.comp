#version 450

#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer KeysIn {
    uint64_t keys_in[];
};

layout(std430, set = 0, binding = 1) readonly buffer ValuesIn {
    uint values_in[];
};

layout(std430, set = 0, binding = 2) writeonly buffer RecordsOut {
    uint records_out[];
};

layout(push_constant) uniform Push {
    uint num_elements;
    uint compact_key48;
    uint _pad1;
    uint _pad2;
} pc;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= pc.num_elements) return;

    const uint64_t key = keys_in[i];
    const uint key_lo = uint(key & uint64_t(0xFFFFFFFFul));
    const uint key_hi = uint(key >> 32u);
    const uint base = i * 3u;
    records_out[base + 0u] = values_in[i];
    if (pc.compact_key48 != 0u) {
        records_out[base + 1u] = (key_lo & 0xFFFFu) << 16u;
        records_out[base + 2u] = ((key_hi & 0xFFFFu) << 16u) | (key_lo >> 16u);
    } else {
        records_out[base + 1u] = key_lo;
        records_out[base + 2u] = key_hi;
    }
}
