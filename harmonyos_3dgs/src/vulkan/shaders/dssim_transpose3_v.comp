#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer Alpha { float alpha[]; };
layout(std430, set = 0, binding = 1) readonly buffer Beta { float beta[]; };
layout(std430, set = 0, binding = 2) readonly buffer Gamma { float gamma[]; };
layout(std430, set = 0, binding = 3) buffer TmpAlpha { float tmp_alpha[]; };
layout(std430, set = 0, binding = 4) buffer TmpBeta { float tmp_beta[]; };
layout(std430, set = 0, binding = 5) buffer TmpGamma { float tmp_gamma[]; };

layout(push_constant) uniform PC {
    uint W;
    uint H;
    uint num_elements;
    float lambda_dssim;
} pc;

const float K[11] = float[11](
    0.0010283801,
    0.0075987581,
    0.0360007721,
    0.1093606895,
    0.2130055377,
    0.2660117249,
    0.2130055377,
    0.1093606895,
    0.0360007721,
    0.0075987581,
    0.0010283801);

void add_sample(uint idx, float w, inout float sa, inout float sb, inout float sg) {
    sa += w * alpha[idx];
    sb += w * beta[idx];
    sg += w * gamma[idx];
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    if (gid >= pc.num_elements) return;

    uint HW = pc.W * pc.H;
    uint ch = gid / HW;
    uint p = gid - ch * HW;
    uint x = p % pc.W;
    uint y = p / pc.W;
    uint base = ch * HW;
    uint hi = pc.H - 1u;

    float sa = 0.0;
    float sb = 0.0;
    float sg = 0.0;
    if (y >= 5u && y + 5u < pc.H) {
        for (int d = -5; d <= 5; ++d) {
            add_sample(base + (y + 5u - uint(d + 5)) * pc.W + x, K[d + 5], sa, sb, sg);
        }
    } else {
        for (int d = -5; d <= 5; ++d) {
            int cy = int(y) - d;
            if (cy >= 0 && cy < int(pc.H)) {
                add_sample(base + uint(cy) * pc.W + x, K[d + 5], sa, sb, sg);
            }
        }
    }
    // Adjoint of clamp blur: interior symmetric taps plus boundary clamp spill.
    if (y == 0u) {
        uint cmax = min(hi, 4u);
        for (uint cy = 0u; cy <= cmax; ++cy) {
            for (int d = -5; d <= -int(cy) - 1; ++d) {
                add_sample(base + cy * pc.W + x, K[d + 5], sa, sb, sg);
            }
        }
    }
    if (y == hi) {
        uint cmin = hi > 4u ? hi - 4u : 0u;
        for (uint cy = cmin; cy <= hi; ++cy) {
            for (int d = int(pc.H) - int(cy); d <= 5; ++d) {
                add_sample(base + cy * pc.W + x, K[d + 5], sa, sb, sg);
            }
        }
    }

    tmp_alpha[gid] = sa;
    tmp_beta[gid] = sb;
    tmp_gamma[gid] = sg;
}
