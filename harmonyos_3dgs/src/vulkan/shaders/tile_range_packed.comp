#version 450
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer KeyvalsSorted {
    uint64_t keyvals_sorted[];
};

layout(std430, set = 0, binding = 1) buffer TileRanges {
    uint tile_ranges[];
};

layout(push_constant) uniform PC {
    uint num_elements;
    uint num_tiles;
    uint _pad0;
    uint _pad1;
} pc;

const uint kTileMask = 0xFFFFu;
const int kTileShift = 48;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.num_elements) return;

    uint tile_id_cur = uint(keyvals_sorted[i] >> kTileShift) & kTileMask;
    if (tile_id_cur >= pc.num_tiles) return;

    bool is_start = (i == 0u) ||
                    ((uint(keyvals_sorted[i - 1u] >> kTileShift) & kTileMask) != tile_id_cur);
    bool is_end = (i == pc.num_elements - 1u) ||
                  ((uint(keyvals_sorted[i + 1u] >> kTileShift) & kTileMask) != tile_id_cur);

    if (is_start) tile_ranges[tile_id_cur * 2u + 0u] = i;
    if (is_end) tile_ranges[tile_id_cur * 2u + 1u] = i + 1u;
}
