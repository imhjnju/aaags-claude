#version 450

// SP-3 T23: preprocess_backward.comp
//
// Per-Gaussian backward pass for the preprocessor.
// Mirrors PreprocessorBackwardCPU::backward() from preprocessor_backward_cpu.cpp.
//
// Algorithm per active Gaussian i (radii[i] > 0):
//   Part A: d_conics -> d_cov2D -> d_cov3D -> d_T -> d_p_view -> d_means3D (cov path)
//   Part B: d_cov3D -> d_M -> d_raw_scales, d_raw_rotations
//   Part C: d_rgb -> d_sh (SH backward)
//   Part D: d_means2D -> d_means3D (projection path)
//   Part E: d_opacity_2d -> d_raw_opacity (sigmoid backward)
//
// Key conventions (match preprocessor_backward_cpu.cpp exactly):
//   - Quaternion order: (r, x, y, z)  (rotations[i*4+0..3])
//   - R[row][col] indexing (conceptually row-major, stored flat row-major)
//   - W[col][row] = upper-left 3x3 of column-major view_matrix
//     i.e. W = transpose(mat3(view_matrix))
//   - T = W * J  (mat3 * mat3)
//   - cov3D upper triangle: [0]=xx, [1]=xy, [2]=xz, [3]=yy, [4]=yz, [5]=zz
//   - Conic packed as (a,b,c): a=cov2D.z/det, b=-cov2D.y/det, c=cov2D.x/det
//     (same as forward: conic.a = cov2D_c/det, conic.c = cov2D_a/det)
//   - d_conics[i*3+0] = dL/da, [1] = dL/db, [2] = dL/dc

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

// ---- SSBOs -----------------------------------------------------------------
layout(std430, set = 0, binding = 0)  readonly  buffer BufPositions  { float positions[];  };
layout(std430, set = 0, binding = 1)  readonly  buffer BufRadii      { int   radii[];      };
layout(std430, set = 0, binding = 2)  readonly  buffer BufCov3D      { float cov3D[];      };
layout(std430, set = 0, binding = 3)  readonly  buffer BufDConics    { float d_conics[];   };
layout(std430, set = 0, binding = 4)  readonly  buffer BufDOpacity   { float d_opacity[];  };
layout(std430, set = 0, binding = 5)  readonly  buffer BufSHCoeffs   { float sh_coeffs[];  };
layout(std430, set = 0, binding = 6)  readonly  buffer BufScales     { float scales[];     };
layout(std430, set = 0, binding = 7)  readonly  buffer BufRotations  { float rotations[];  };
layout(std430, set = 0, binding = 8)  readonly  buffer BufDRgb       { float d_rgb[];      };
layout(std430, set = 0, binding = 9)  readonly  buffer BufDMeans2D   { float d_means2D[];  };
layout(std430, set = 0, binding = 10) writeonly buffer BufDMeans3D   { float d_means3D[];  };
layout(std430, set = 0, binding = 11) writeonly buffer BufDSH        { float d_sh[];       };
layout(std430, set = 0, binding = 12) writeonly buffer BufDScales    { float d_scales[];   };
layout(std430, set = 0, binding = 13) writeonly buffer BufDRotations { float d_rotations[];};
layout(std430, set = 0, binding = 14) readonly  buffer BufOpacities     { float opacities[];     };
layout(std430, set = 0, binding = 15) writeonly buffer BufDRawOpacities { float d_raw_opacities[];};
layout(std430, set = 0, binding = 17) readonly  buffer BufRawRotations  { float raw_rotations[]; };
layout(std430, set = 0, binding = 18) readonly  buffer BufMeans2DCache  { float means2D_cache[]; };
layout(std430, set = 0, binding = 19) readonly  buffer BufPViewCacheIn    { float p_view_cache_in[];    };
layout(std430, set = 0, binding = 20) readonly  buffer BufCov2DCacheIn    { float cov2D_cache_in[];     };
layout(std430, set = 0, binding = 21) readonly  buffer BufCov2DDetCacheIn { float cov2D_det_cache_in[]; };
layout(std430, set = 0, binding = 22) readonly  buffer BufPHomWCacheIn    { float p_hom_w_cache_in[];   };

// ---- UBO (std140, binding 16) ----------------------------------------------
layout(std140, set = 0, binding = 16) uniform PreprocessBwdUBO {
    mat4     view_matrix;     // column-major 4x4
    mat4     proj_matrix;     // column-major 4x4 (viewproj)
    uint     num_gaussians;
    uint     sh_degree;
    uint     sh_coeffs_per_g; // (sh_degree+1)^2
    float    scale_modifier;
    float    h_x;             // W / (2 * tan_fovx)
    float    h_y;             // H / (2 * tan_fovy)
    float    tan_fovx;
    float    tan_fovy;
    vec3     cam_pos;
    float    _pad;
    uint     training;        // 1 = training (no clamp upper)
    uint     cam_width;       // pixel width  (offset 180)
    uint     cam_height;      // pixel height (offset 184)
    uint     _pad2;
} ubo;

// ---- SH constants ----------------------------------------------------------
const float SH_C0 = 0.28209479177387814;
const float SH_C1 = 0.4886025119029199;
const float SH_C2[5] = float[5](
     1.0925484305920792,
    -1.0925484305920792,
     0.31539156525252005,
    -1.0925484305920792,
     0.5462742152960396
);
const float SH_C3[7] = float[7](
    -0.5900435899266435,
     2.890611442640554,
    -0.4570457994644658,
     0.3731763325901154,
    -0.4570457994644658,
     1.445305721320277,
    -0.5900435899266435
);

// ---- Matrix helpers --------------------------------------------------------

// R[row][col] from quaternion (r, x, y, z).
// Matches math_utils.cpp::quat2mat / preprocess.comp::quat2mat.
// Stored flat as R[row*3 + col].
void quat2R(float qr, float qx, float qy, float qz, out float R[9]) {
    R[0] = 1.0 - 2.0*(qy*qy + qz*qz);
    R[1] = 2.0*(qx*qy + qr*qz);
    R[2] = 2.0*(qx*qz - qr*qy);
    R[3] = 2.0*(qx*qy - qr*qz);
    R[4] = 1.0 - 2.0*(qx*qx + qz*qz);
    R[5] = 2.0*(qy*qz + qr*qx);
    R[6] = 2.0*(qx*qz + qr*qy);
    R[7] = 2.0*(qy*qz - qr*qx);
    R[8] = 1.0 - 2.0*(qx*qx + qy*qy);
}

// ============================================================================
// Main
// ============================================================================
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= ubo.num_gaussians) return;

    // Default output: zero for culled Gaussians.
    uint base3 = i * 3u;
    uint base4 = i * 4u;
    uint base_sh = i * ubo.sh_coeffs_per_g * 3u;

    // Check visibility
    if (radii[i] <= 0) {
        // Write zero gradients for culled Gaussians
        d_means3D[base3 + 0u] = 0.0;
        d_means3D[base3 + 1u] = 0.0;
        d_means3D[base3 + 2u] = 0.0;
        for (uint k = 0; k < ubo.sh_coeffs_per_g * 3u; k++)
            d_sh[base_sh + k] = 0.0;
        d_scales[base3 + 0u]    = 0.0;
        d_scales[base3 + 1u]    = 0.0;
        d_scales[base3 + 2u]    = 0.0;
        d_rotations[base4 + 0u] = 0.0;
        d_rotations[base4 + 1u] = 0.0;
        d_rotations[base4 + 2u] = 0.0;
        d_rotations[base4 + 3u] = 0.0;
        d_raw_opacities[i] = 0.0;
        return;
    }

    vec3 pos = vec3(positions[base3], positions[base3+1u], positions[base3+2u]);

    // Accumulated position gradient (multiple chains contribute)
    float d_pos_x = 0.0;
    float d_pos_y = 0.0;
    float d_pos_z = 0.0;

    // =========================================================================
    // Part A: d_conics -> d_cov2D -> d_cov3D
    // =========================================================================
    // Forward conic = {a, b, c} where:
    //   a = cov2D_filt.z / det  (element [2])
    //   b = -cov2D_filt.y / det (element [1])
    //   c = cov2D_filt.x / det  (element [0])
    //   det = cov2D_filt.x * cov2D_filt.z - cov2D_filt.y^2
    // with cov2D_filt.x = cov2D.x + 0.3, cov2D_filt.z = cov2D.z + 0.3
    //
    // Use cached p_view from forward (binding 19) to get the unclamped view-space
    // position. Then apply the same clamping the forward did to recover the
    // exact t used in the Jacobian — avoiding cross-platform FP divergence from
    // recomputing view_matrix * pos on a different arithmetic path.
    //
    // Use cached dilated cov2D (binding 20) and det (binding 21) from forward
    // so fa/fb/fc/det are bit-exact with what the forward wrote to the conic.
    // This eliminates ~0.82 abs error in d_raw_positions from Part A recompute.
    vec3 t = vec3(p_view_cache_in[base3 + 0u],
                  p_view_cache_in[base3 + 1u],
                  p_view_cache_in[base3 + 2u]);

    // Clamp to frustum (same as forward)
    float limx = 1.3 * ubo.tan_fovx;
    float limy = 1.3 * ubo.tan_fovy;
    float txtz = t.x / t.z;
    float tytz = t.y / t.z;
    // x_grad_mul / y_grad_mul: whether clamping was active
    float x_grad_mul = ((txtz < -limx) || (txtz > limx)) ? 0.0 : 1.0;
    float y_grad_mul = ((tytz < -limy) || (tytz > limy)) ? 0.0 : 1.0;
    // Apply clamp (same as forward to get the actual t used in Jacobian)
    t.x = clamp(txtz, -limx, limx) * t.z;
    t.y = clamp(tytz, -limy, limy) * t.z;

    // Jacobian J (column-major mat3):
    //   col0 = (h_x/t.z, 0, -h_x*t.x/t.z^2)
    //   col1 = (0, h_y/t.z, -h_y*t.y/t.z^2)
    //   col2 = (0, 0, 0)
    float tz2 = t.z * t.z;
    mat3 J = mat3(
        vec3(ubo.h_x / t.z, 0.0, -(ubo.h_x * t.x) / tz2),
        vec3(0.0, ubo.h_y / t.z, -(ubo.h_y * t.y) / tz2),
        vec3(0.0, 0.0, 0.0)
    );

    // W = transpose(upper-left 3x3 of view_matrix)
    // mat3(mat4) extracts first 3 columns; transpose() gives math-transposed form
    // matching CPU: W[col][row] = vm[col*4 + row]
    mat3 W = transpose(mat3(ubo.view_matrix));

    // T = W * J  (still needed for d_Vrk computation below)
    mat3 T = W * J;

    // Vrk from upper-triangle cov3D cache (needed for d_T -> d_cov3D path)
    uint c3d = i * 6u;
    float cv0 = cov3D[c3d+0u]; // xx
    float cv1 = cov3D[c3d+1u]; // xy
    float cv2 = cov3D[c3d+2u]; // xz
    float cv3 = cov3D[c3d+3u]; // yy
    float cv4 = cov3D[c3d+4u]; // yz
    float cv5 = cov3D[c3d+5u]; // zz

    mat3 Vrk = mat3(
        vec3(cv0, cv1, cv2),
        vec3(cv1, cv3, cv4),
        vec3(cv2, cv4, cv5)
    );

    // Use cached filtered cov2D and det from forward (avoids FP divergence from recompute).
    // These are the exact values written by preprocess.comp after +0.3 dilation.
    float fa = cov2D_cache_in[base3 + 0u];    // fa = cov2D.x + 0.3 (dilated)
    float fb = cov2D_cache_in[base3 + 1u];    // fb = cov2D.y
    float fc = cov2D_cache_in[base3 + 2u];    // fc = cov2D.z + 0.3 (dilated)
    float det = cov2D_det_cache_in[i];        // det = fa*fc - fb*fb
    // NaN guard only: if det is so close to zero that det*det underflows to
    // exactly zero, the soft epsilon below would still produce +Inf.  Use a
    // very tight bound (1e-20) so only catastrophically degenerate Gaussians
    // are skipped.  For nearly-singular 2D covariances the 1e-7 soft epsilon
    // in inv_det2 naturally damps gradients (matches CUDA denom2inv pattern).
    if (abs(det) < 1e-20) {
        // Catastrophically degenerate: write zero gradients
        d_means3D[base3 + 0u] = 0.0;
        d_means3D[base3 + 1u] = 0.0;
        d_means3D[base3 + 2u] = 0.0;
        for (uint k = 0; k < ubo.sh_coeffs_per_g * 3u; k++)
            d_sh[base_sh + k] = 0.0;
        d_scales[base3 + 0u]    = 0.0;
        d_scales[base3 + 1u]    = 0.0;
        d_scales[base3 + 2u]    = 0.0;
        d_rotations[base4 + 0u] = 0.0;
        d_rotations[base4 + 1u] = 0.0;
        d_rotations[base4 + 2u] = 0.0;
        d_rotations[base4 + 3u] = 0.0;
        d_raw_opacities[i] = 0.0;
        return;
    }

    // Read upstream conic gradients: d_conics[i*3] = dL/da, [1] = dL/db, [2] = dL/dc
    // Note: conic stored as (a,b,c) = (fc/det, -fb/det, fa/det)
    float dc0 = d_conics[base3 + 0u]; // dL/da = dL/d(fc/det)
    float dc1 = d_conics[base3 + 1u]; // dL/db = dL/d(-fb/det)
    float dc2 = d_conics[base3 + 2u]; // dL/dc = dL/d(fa/det)

    // Backward through conic inversion (matches preprocessor_backward_cpu.cpp:296-306)
    // conic = (fc/det, -fb/det, fa/det)
    // d_fa = dc0*(-fc^2/det^2) + dc1*(fb*fc/det^2) + dc2*(-fb^2/det^2)
    // d_fb = dc0*(2*fb*fc/det^2) + dc1*(-(fa*fc+fb^2)/det^2) + dc2*(2*fa*fb/det^2)
    // d_fc = dc0*(-fb^2/det^2) + dc1*(fa*fb/det^2) + dc2*(-fa^2/det^2)
    //
    // Soft epsilon matches CUDA reference: denom2inv = 1/(denom*denom + 1e-7).
    // For well-conditioned Gaussians (det >> 1e-7^0.5) the correction is ~0.
    // For nearly-degenerate cases it prevents catastrophic gradient blow-up.
    // Evidence: CUDA diff3d_backward.cu uses 0.0000001f in the denom2 term.
    float inv_det2 = 1.0 / (det * det + 1e-7);
    float d_fa = dc0 * (-fc*fc * inv_det2)
               + dc1 * (fb*fc * inv_det2)
               + dc2 * (-fb*fb * inv_det2);
    float d_fb = dc0 * (2.0*fb*fc * inv_det2)
               + dc1 * (-(fa*fc + fb*fb) * inv_det2)
               + dc2 * (2.0*fa*fb * inv_det2);
    float d_fc = dc0 * (-fb*fb * inv_det2)
               + dc1 * (fa*fb * inv_det2)
               + dc2 * (-fa*fa * inv_det2);

    // Add h_conv_scaling chain contributions (matches preprocessor_backward_cpu.cpp).
    // Forward (preprocess.comp): opa_2d = sigma * h_conv, h_conv = sqrt(max(0.000025, det_orig/det_dilated))
    //   det_orig    = (fa-0.3)*(fc-0.3) - fb^2     (pre-dilation diag det)
    //   det_dilated = fa*fc - fb^2 = det           (post-dilation, cached)
    // Only applies when h_conv is unclamped (r > 0.000025), otherwise dh/d* = 0.
    float a_raw_cov  = fa - 0.3;
    float c_raw_cov  = fc - 0.3;
    float det_orig   = a_raw_cov * c_raw_cov - fb * fb;
    float r_bwd      = (det != 0.0) ? (det_orig / det) : 0.0;
    if (r_bwd > 0.000025) {
        float h_conv_bwd = sqrt(r_bwd);
        // d_h = d_opacities_2d[i] * sigma; d_r = d_h * 0.5/h_conv
        float sigma_bwd = opacities[i];
        float d_h       = d_opacity[i] * sigma_bwd;
        float d_r       = d_h * 0.5 / h_conv_bwd;
        float d_det_orig    = d_r / det;
        float d_det_dilated = d_r * (-det_orig / (det * det));
        // d_det_orig/d_fa = c_raw, d_det_dilated/d_fa = fc (post-dilation)
        // d_det_orig/d_fb = -2*fb, d_det_dilated/d_fb = -2*fb
        // d_det_orig/d_fc = a_raw, d_det_dilated/d_fc = fa
        d_fa += d_det_orig * c_raw_cov + d_det_dilated * fc;
        d_fb += (d_det_orig + d_det_dilated) * (-2.0 * fb);
        d_fc += d_det_orig * a_raw_cov + d_det_dilated * fa;
    }

    // Gradient through the +0.3 filter (constant offset, gradient passes through)
    // d_cov2D_a = d_fa, d_cov2D_b = d_fb, d_cov2D_c = d_fc

    // ----
    // Backward: d_Vrk from d_cov2D
    //   cov2D = T^T * Vrk * T
    //   result[c][r] = sum_{k,j} T[r][k] * Vrk[k][j] * T[c][j]
    //   cov2D[0] = result[0][0], cov2D[1] = result[1][0], cov2D[2] = result[1][1]
    //   d_Vrk[k][j] = d_fa*T[0][k]*T[0][j] + d_fb*T[0][k]*T[1][j] + d_fc*T[1][k]*T[1][j]
    //
    // T is column-major mat3: T[col][row], so T[0] = column 0, T[1] = column 1, T[2] = column 2
    float d_Vrk[9]; // [k*3+j]
    for (int k = 0; k < 3; k++) {
        for (int j = 0; j < 3; j++) {
            // T[col][row]: T[0][k] means column 0, row k -> T[0].x, T[0].y, T[0].z for k=0,1,2
            float T0k = T[0][k];  // column 0, row k
            float T1k = T[1][k];  // column 1, row k
            float T0j = T[0][j];
            float T1j = T[1][j];
            d_Vrk[k*3+j] = d_fa * T0k * T0j
                          + d_fb * T0k * T1j
                          + d_fc * T1k * T1j;
        }
    }

    // Map d_Vrk (3x3 symmetric in k,j) to d_cov3D upper-triangle (6 elements)
    // cov3D: [0]=xx=[0][0], [1]=xy=[0][1]==[1][0], [2]=xz=[0][2]==[2][0],
    //        [3]=yy=[1][1],  [4]=yz=[1][2]==[2][1], [5]=zz=[2][2]
    float d_cov3D[6];
    d_cov3D[0] = d_Vrk[0*3+0];
    d_cov3D[1] = d_Vrk[0*3+1] + d_Vrk[1*3+0];
    d_cov3D[2] = d_Vrk[0*3+2] + d_Vrk[2*3+0];
    d_cov3D[3] = d_Vrk[1*3+1];
    d_cov3D[4] = d_Vrk[1*3+2] + d_Vrk[2*3+1];
    d_cov3D[5] = d_Vrk[2*3+2];

    // ----
    // Backward: d_T from d_cov2D  (for position gradient via J -> t)
    //   VT[col][row] = sum_k Vrk[row][k] * T[col][k]  (= Vrk * T)
    //   d_T[0][q] = 2*d_fa*VT[0][q] + d_fb*VT[1][q]
    //   d_T[1][q] = d_fb*VT[0][q] + 2*d_fc*VT[1][q]
    // (only cols 0 and 1 of d_T are needed)
    mat3 VT = Vrk * T;  // Vrk * T: VT[col][row] = sum_k Vrk[row][k] * T[col][k]

    // d_T_cov[col][row] for col=0,1:
    float d_T00, d_T01, d_T02;  // d_T[0][0..2]
    float d_T10, d_T11, d_T12;  // d_T[1][0..2]
    d_T00 = 2.0 * d_fa * VT[0][0] + d_fb * VT[1][0];
    d_T01 = 2.0 * d_fa * VT[0][1] + d_fb * VT[1][1];
    d_T02 = 2.0 * d_fa * VT[0][2] + d_fb * VT[1][2];
    d_T10 = d_fb * VT[0][0] + 2.0 * d_fc * VT[1][0];
    d_T11 = d_fb * VT[0][1] + 2.0 * d_fc * VT[1][1];
    d_T12 = d_fb * VT[0][2] + 2.0 * d_fc * VT[1][2];

    // Backward through T = W * J:
    //   T[col][row] = sum_k W[k][row] * J[col][k]
    //   d_J[col][k] = sum_row d_T[col][row] * W[k][row]
    // W is column-major mat3: W[col][row], so W[k][row] = W[k].row = W[k][row]
    // d_J[0][k] = sum_row (2*d_fa*VT[0][row] + d_fb*VT[1][row]) * W[k][row]
    float d_J00, d_J02, d_J11, d_J12;
    // d_J[0][0] = d_T00*W[0][0] + d_T01*W[0][1] + d_T02*W[0][2]
    //           = d_T00*W[0].x + d_T01*W[0].y + d_T02*W[0].z
    d_J00 = d_T00*W[0][0] + d_T01*W[0][1] + d_T02*W[0][2];
    // d_J[0][2] = d_T00*W[2][0] + d_T01*W[2][1] + d_T02*W[2][2]
    d_J02 = d_T00*W[2][0] + d_T01*W[2][1] + d_T02*W[2][2];
    // d_J[1][1] = d_T10*W[1][0] + d_T11*W[1][1] + d_T12*W[1][2]
    d_J11 = d_T10*W[1][0] + d_T11*W[1][1] + d_T12*W[1][2];
    // d_J[1][2] = d_T10*W[2][0] + d_T11*W[2][1] + d_T12*W[2][2]
    d_J12 = d_T10*W[2][0] + d_T11*W[2][1] + d_T12*W[2][2];

    // Backward through J -> clamped t:
    //   J[0][0] = h_x/t.z  -> dL/dt.z += d_J00 * (-h_x/t.z^2)
    //   J[0][2] = -h_x*t.x/t.z^2 -> dL/dt.x += d_J02*(-h_x/t.z^2), dL/dt.z += d_J02*(2*h_x*t.x/t.z^3)
    //   J[1][1] = h_y/t.z  -> dL/dt.z += d_J11 * (-h_y/t.z^2)
    //   J[1][2] = -h_y*t.y/t.z^2 -> dL/dt.y += d_J12*(-h_y/t.z^2), dL/dt.z += d_J12*(2*h_y*t.y/t.z^3)
    float tz3 = tz2 * t.z;
    float d_tx = d_J02 * (-ubo.h_x / tz2);
    float d_ty = d_J12 * (-ubo.h_y / tz2);
    float d_tz = d_J00 * (-ubo.h_x / tz2)
               + d_J11 * (-ubo.h_y / tz2)
               + d_J02 * (2.0 * ubo.h_x * t.x / tz3)
               + d_J12 * (2.0 * ubo.h_y * t.y / tz3);

    // Apply clamping mask (if clamped, no gradient flows through that component)
    d_tx *= x_grad_mul;
    d_ty *= y_grad_mul;

    // Backward through view transform: p_view = view_matrix * [pos, 1]
    // p_view[row] = sum_col view[col*4+row] * pos[col] + view[12+row]
    // d_pos[col] = sum_row d_p_view[row] * view[col*4+row]
    // In column-major mat4: ubo.view_matrix[col][row]
    d_pos_x += d_tx * ubo.view_matrix[0][0] + d_ty * ubo.view_matrix[0][1] + d_tz * ubo.view_matrix[0][2];
    d_pos_y += d_tx * ubo.view_matrix[1][0] + d_ty * ubo.view_matrix[1][1] + d_tz * ubo.view_matrix[1][2];
    d_pos_z += d_tx * ubo.view_matrix[2][0] + d_ty * ubo.view_matrix[2][1] + d_tz * ubo.view_matrix[2][2];

    // =========================================================================
    // Part B: d_cov3D -> d_M -> d_raw_scales, d_raw_rotations
    // =========================================================================
    // Load scale and rotation for this Gaussian
    float sx = ubo.scale_modifier * scales[base3 + 0u];
    float sy = ubo.scale_modifier * scales[base3 + 1u];
    float sz = ubo.scale_modifier * scales[base3 + 2u];

    float qr = rotations[base4 + 0u];
    float qx = rotations[base4 + 1u];
    float qy = rotations[base4 + 2u];
    float qz = rotations[base4 + 3u];

    float R[9];
    quat2R(qr, qx, qy, qz, R);
    // R[row*3+col]

    // M[row][col] = s[row] * R[row][col]
    float s[3] = float[3](sx, sy, sz);
    float M[9]; // [row*3+col]
    for (int row = 0; row < 3; row++)
        for (int col = 0; col < 3; col++)
            M[row*3+col] = s[row] * R[row*3+col];

    // dL/dM from d_cov3D (upper triangle):
    // Sigma = M^T * M: Sigma[r][c] = sum_k M[k][r] * M[k][c]
    // d_M[k][0] = 2*d_cov3D[0]*M[k][0] + d_cov3D[1]*M[k][1] + d_cov3D[2]*M[k][2]
    // d_M[k][1] = d_cov3D[1]*M[k][0] + 2*d_cov3D[3]*M[k][1] + d_cov3D[4]*M[k][2]
    // d_M[k][2] = d_cov3D[2]*M[k][0] + d_cov3D[4]*M[k][1] + 2*d_cov3D[5]*M[k][2]
    float d_M[9]; // [k*3+col]
    for (int k = 0; k < 3; k++) {
        d_M[k*3+0] = 2.0*d_cov3D[0]*M[k*3+0] + d_cov3D[1]*M[k*3+1] + d_cov3D[2]*M[k*3+2];
        d_M[k*3+1] = d_cov3D[1]*M[k*3+0] + 2.0*d_cov3D[3]*M[k*3+1] + d_cov3D[4]*M[k*3+2];
        d_M[k*3+2] = d_cov3D[2]*M[k*3+0] + d_cov3D[4]*M[k*3+1] + 2.0*d_cov3D[5]*M[k*3+2];
    }

    // d_scale[k] = sum_j d_M[k][j] * R[k][j]
    // d_R[k][j] = d_M[k][j] * s[k]
    float d_scale0 = 0.0, d_scale1 = 0.0, d_scale2 = 0.0;
    float d_R[9]; // [k*3+j]
    for (int j = 0; j < 3; j++) {
        d_scale0 += d_M[0*3+j] * R[0*3+j];
        d_scale1 += d_M[1*3+j] * R[1*3+j];
        d_scale2 += d_M[2*3+j] * R[2*3+j];
        d_R[0*3+j] = d_M[0*3+j] * s[0];
        d_R[1*3+j] = d_M[1*3+j] * s[1];
        d_R[2*3+j] = d_M[2*3+j] * s[2];
    }

    // d_raw_scale[k] = d_scale[k] * scale_modifier * scale_k
    // (since scale_in_M = scale_modifier * exp(raw_scale), d/d_raw_scale = scale_modifier * scale)
    d_scales[base3 + 0u] = d_scale0 * ubo.scale_modifier * scales[base3 + 0u];
    d_scales[base3 + 1u] = d_scale1 * ubo.scale_modifier * scales[base3 + 1u];
    d_scales[base3 + 2u] = d_scale2 * ubo.scale_modifier * scales[base3 + 2u];

    // d_R -> d_normalized_quaternion (r,x,y,z)
    // R[0][0] = 1-2(y^2+z^2)  -> dR[0][0]/dy = -4y, /dz = -4z
    // R[0][1] = 2(xy+rz)      -> dR[0][1]/dr = 2z, /dx = 2y, /dy = 2x, /dz = 2r
    // R[0][2] = 2(xz-ry)      -> dR[0][2]/dr = -2y, /dx = 2z, /dy = -2r, /dz = 2x
    // R[1][0] = 2(xy-rz)      -> dR[1][0]/dr = -2z, /dx = 2y, /dy = 2x, /dz = -2r
    // R[1][1] = 1-2(x^2+z^2)  -> dR[1][1]/dx = -4x, /dz = -4z
    // R[1][2] = 2(yz+rx)      -> dR[1][2]/dr = 2x, /dx = 2r, /dy = 2z, /dz = 2y
    // R[2][0] = 2(xz+ry)      -> dR[2][0]/dr = 2y, /dx = 2z, /dy = 2r, /dz = 2x
    // R[2][1] = 2(yz-rx)      -> dR[2][1]/dr = -2x, /dx = -2r, /dy = 2z, /dz = 2y
    // R[2][2] = 1-2(x^2+y^2)  -> dR[2][2]/dx = -4x, /dy = -4y
    // (Matches preprocessor_backward_cpu.cpp:457-503)
    float d_qn_r = 0.0, d_qn_x = 0.0, d_qn_y = 0.0, d_qn_z = 0.0;

    // R[0][0] row=0, col=0
    d_qn_y += d_R[0*3+0] * (-4.0*qy);
    d_qn_z += d_R[0*3+0] * (-4.0*qz);
    // R[0][1] row=0, col=1
    d_qn_r += d_R[0*3+1] * 2.0*qz;
    d_qn_x += d_R[0*3+1] * 2.0*qy;
    d_qn_y += d_R[0*3+1] * 2.0*qx;
    d_qn_z += d_R[0*3+1] * 2.0*qr;
    // R[0][2] row=0, col=2
    d_qn_r += d_R[0*3+2] * (-2.0*qy);
    d_qn_x += d_R[0*3+2] * 2.0*qz;
    d_qn_y += d_R[0*3+2] * (-2.0*qr);
    d_qn_z += d_R[0*3+2] * 2.0*qx;
    // R[1][0] row=1, col=0
    d_qn_r += d_R[1*3+0] * (-2.0*qz);
    d_qn_x += d_R[1*3+0] * 2.0*qy;
    d_qn_y += d_R[1*3+0] * 2.0*qx;
    d_qn_z += d_R[1*3+0] * (-2.0*qr);
    // R[1][1] row=1, col=1
    d_qn_x += d_R[1*3+1] * (-4.0*qx);
    d_qn_z += d_R[1*3+1] * (-4.0*qz);
    // R[1][2] row=1, col=2
    d_qn_r += d_R[1*3+2] * 2.0*qx;
    d_qn_x += d_R[1*3+2] * 2.0*qr;
    d_qn_y += d_R[1*3+2] * 2.0*qz;
    d_qn_z += d_R[1*3+2] * 2.0*qy;
    // R[2][0] row=2, col=0
    d_qn_r += d_R[2*3+0] * 2.0*qy;
    d_qn_x += d_R[2*3+0] * 2.0*qz;
    d_qn_y += d_R[2*3+0] * 2.0*qr;
    d_qn_z += d_R[2*3+0] * 2.0*qx;
    // R[2][1] row=2, col=1
    d_qn_r += d_R[2*3+1] * (-2.0*qx);
    d_qn_x += d_R[2*3+1] * (-2.0*qr);
    d_qn_y += d_R[2*3+1] * 2.0*qz;
    d_qn_z += d_R[2*3+1] * 2.0*qy;
    // R[2][2] row=2, col=2
    d_qn_x += d_R[2*3+2] * (-4.0*qx);
    d_qn_y += d_R[2*3+2] * (-4.0*qy);

    // d_normalized_quat -> d_raw_quat through quaternion normalization
    // q_norm = q_raw / |q_raw|
    // d_raw[k] = (d_norm[k] - q_norm[k] * dot(d_norm, q_norm)) / |q_raw|
    // Matches CPU: preprocessor_backward_cpu.cpp:505-519.
    // rotations[] holds the normalized quaternion (qr, qx, qy, qz); raw_rotations[]
    // holds the unnormalized input quaternion needed for the |q_raw| denominator.
    float qrr = raw_rotations[base4 + 0u];
    float qrx = raw_rotations[base4 + 1u];
    float qry = raw_rotations[base4 + 2u];
    float qrz = raw_rotations[base4 + 3u];
    float q_raw_len = max(sqrt(qrr*qrr + qrx*qrx + qry*qry + qrz*qrz), 1e-12);
    float inv_len = 1.0 / q_raw_len;

    float dot_dqn_qn = d_qn_r*qr + d_qn_x*qx + d_qn_y*qy + d_qn_z*qz;

    d_rotations[base4 + 0u] = (d_qn_r - qr * dot_dqn_qn) * inv_len;
    d_rotations[base4 + 1u] = (d_qn_x - qx * dot_dqn_qn) * inv_len;
    d_rotations[base4 + 2u] = (d_qn_y - qy * dot_dqn_qn) * inv_len;
    d_rotations[base4 + 3u] = (d_qn_z - qz * dot_dqn_qn) * inv_len;

    // =========================================================================
    // Part C: d_rgb -> d_sh (SH backward)
    // =========================================================================
    vec3 dir = normalize(pos - ubo.cam_pos);
    float dx = dir.x, dy = dir.y, dz = dir.z;

    // Recompute forward SH value (per channel) to determine clamp mask
    // (same as computeColorFromSH_backward in preprocessor_backward_cpu.cpp)
    uint K = ubo.sh_coeffs_per_g;
    uint sh_base = i * K * 3u;

    float rgb_raw_r = SH_C0 * sh_coeffs[sh_base + 0u*3u + 0u];
    float rgb_raw_g = SH_C0 * sh_coeffs[sh_base + 0u*3u + 1u];
    float rgb_raw_b = SH_C0 * sh_coeffs[sh_base + 0u*3u + 2u];

    if (ubo.sh_degree > 0u) {
        rgb_raw_r += -SH_C1*dy*sh_coeffs[sh_base+1u*3u+0u] + SH_C1*dz*sh_coeffs[sh_base+2u*3u+0u] - SH_C1*dx*sh_coeffs[sh_base+3u*3u+0u];
        rgb_raw_g += -SH_C1*dy*sh_coeffs[sh_base+1u*3u+1u] + SH_C1*dz*sh_coeffs[sh_base+2u*3u+1u] - SH_C1*dx*sh_coeffs[sh_base+3u*3u+1u];
        rgb_raw_b += -SH_C1*dy*sh_coeffs[sh_base+1u*3u+2u] + SH_C1*dz*sh_coeffs[sh_base+2u*3u+2u] - SH_C1*dx*sh_coeffs[sh_base+3u*3u+2u];

        if (ubo.sh_degree > 1u) {
            float xx = dx*dx, yy = dy*dy, zz = dz*dz;
            float xy = dx*dy, yz = dy*dz, xz = dx*dz;
            for (int ch = 0; ch < 3; ch++) {
                float v = SH_C2[0]*xy*sh_coeffs[sh_base+4u*3u+ch]
                        + SH_C2[1]*yz*sh_coeffs[sh_base+5u*3u+ch]
                        + SH_C2[2]*(2.0*zz-xx-yy)*sh_coeffs[sh_base+6u*3u+ch]
                        + SH_C2[3]*xz*sh_coeffs[sh_base+7u*3u+ch]
                        + SH_C2[4]*(xx-yy)*sh_coeffs[sh_base+8u*3u+ch];
                if (ch == 0) rgb_raw_r += v;
                else if (ch == 1) rgb_raw_g += v;
                else rgb_raw_b += v;
            }

            if (ubo.sh_degree > 2u) {
                for (int ch = 0; ch < 3; ch++) {
                    float v = SH_C3[0]*dy*(3.0*xx-yy)*sh_coeffs[sh_base+9u*3u+ch]
                            + SH_C3[1]*xy*dz*sh_coeffs[sh_base+10u*3u+ch]
                            + SH_C3[2]*dy*(4.0*zz-xx-yy)*sh_coeffs[sh_base+11u*3u+ch]
                            + SH_C3[3]*dz*(2.0*zz-3.0*xx-3.0*yy)*sh_coeffs[sh_base+12u*3u+ch]
                            + SH_C3[4]*dx*(4.0*zz-xx-yy)*sh_coeffs[sh_base+13u*3u+ch]
                            + SH_C3[5]*dz*(xx-yy)*sh_coeffs[sh_base+14u*3u+ch]
                            + SH_C3[6]*dx*(xx-3.0*yy)*sh_coeffs[sh_base+15u*3u+ch];
                    if (ch == 0) rgb_raw_r += v;
                    else if (ch == 1) rgb_raw_g += v;
                    else rgb_raw_b += v;
                }
            }
        }
    }

    // Clamp mask: gradient flows through only if rgb_raw + 0.5 >= 0
    float mask_r = (rgb_raw_r + 0.5 >= 0.0) ? 1.0 : 0.0;
    float mask_g = (rgb_raw_g + 0.5 >= 0.0) ? 1.0 : 0.0;
    float mask_b = (rgb_raw_b + 0.5 >= 0.0) ? 1.0 : 0.0;

    // In training mode (ubo.training == 1): apply clamp mask (lower clamp only)
    // In inference mode: upper clamp also active, but we only track lower clamp mask here
    // (The CPU backward also only applies the lower clamp mask regardless of training flag)
    float d_rgb_r = d_rgb[base3 + 0u] * mask_r;
    float d_rgb_g = d_rgb[base3 + 1u] * mask_g;
    float d_rgb_b = d_rgb[base3 + 2u] * mask_b;

    // Degree 0: basis = SH_C0
    d_sh[sh_base + 0u*3u + 0u] = SH_C0 * d_rgb_r;
    d_sh[sh_base + 0u*3u + 1u] = SH_C0 * d_rgb_g;
    d_sh[sh_base + 0u*3u + 2u] = SH_C0 * d_rgb_b;

    if (ubo.sh_degree > 0u) {
        // Degree 1 basis values
        float b1[3] = float[3](-SH_C1*dy, SH_C1*dz, -SH_C1*dx);
        for (int k = 0; k < 3; k++) {
            d_sh[sh_base + uint(1+k)*3u + 0u] = b1[k] * d_rgb_r;
            d_sh[sh_base + uint(1+k)*3u + 1u] = b1[k] * d_rgb_g;
            d_sh[sh_base + uint(1+k)*3u + 2u] = b1[k] * d_rgb_b;
        }

        if (ubo.sh_degree > 1u) {
            float xx = dx*dx, yy = dy*dy, zz = dz*dz;
            float xy = dx*dy, yz = dy*dz, xz = dx*dz;
            float b2[5] = float[5](
                SH_C2[0]*xy,
                SH_C2[1]*yz,
                SH_C2[2]*(2.0*zz - xx - yy),
                SH_C2[3]*xz,
                SH_C2[4]*(xx - yy)
            );
            for (int k = 0; k < 5; k++) {
                d_sh[sh_base + uint(4+k)*3u + 0u] = b2[k] * d_rgb_r;
                d_sh[sh_base + uint(4+k)*3u + 1u] = b2[k] * d_rgb_g;
                d_sh[sh_base + uint(4+k)*3u + 2u] = b2[k] * d_rgb_b;
            }

            if (ubo.sh_degree > 2u) {
                float b3[7] = float[7](
                    SH_C3[0]*dy*(3.0*xx - yy),
                    SH_C3[1]*xy*dz,
                    SH_C3[2]*dy*(4.0*zz - xx - yy),
                    SH_C3[3]*dz*(2.0*zz - 3.0*xx - 3.0*yy),
                    SH_C3[4]*dx*(4.0*zz - xx - yy),
                    SH_C3[5]*dz*(xx - yy),
                    SH_C3[6]*dx*(xx - 3.0*yy)
                );
                for (int k = 0; k < 7; k++) {
                    d_sh[sh_base + uint(9+k)*3u + 0u] = b3[k] * d_rgb_r;
                    d_sh[sh_base + uint(9+k)*3u + 1u] = b3[k] * d_rgb_g;
                    d_sh[sh_base + uint(9+k)*3u + 2u] = b3[k] * d_rgb_b;
                }
            }
        }
    }

    // =========================================================================
    // Part C (continued): d_rgb -> d_pos via SH view-direction dependency
    // (Matches computeColorFromSH_backward in preprocessor_backward_cpu.cpp:122-202)
    // For sh_degree > 0, the SH color depends on the view direction, which
    // depends on position. This contributes d_pos via:
    //   d_pos += Jacobian(normalize(pos-cam_pos)) * d_dir
    // where d_dir = sum_ch d_rgb[ch] * mask[ch] * d(color/SH)/d(dir_k)
    // =========================================================================
    if (ubo.sh_degree > 0u) {
        // d_color_d_dir[0..2] = d(color)/d(dir.x), d(dir.y), d(dir.z)
        // Each is a sum over RGB channels: d_color_d_dir_k = sum_ch d_color/d_dir[k] * sh_basis_k
        // Combined with d_rgb mask: d_loss/d_dir[k] = sum_ch d_rgb_eff[ch] * d_color_d_dir_k_ch

        // Degree 1:
        // color += -SH_C1*dy*sh[1] + SH_C1*dz*sh[2] - SH_C1*dx*sh[3]
        // d/dx = -SH_C1*sh[3], d/dy = -SH_C1*sh[1], d/dz = SH_C1*sh[2]
        float s1r = sh_coeffs[sh_base+1u*3u+0u], s1g = sh_coeffs[sh_base+1u*3u+1u], s1b = sh_coeffs[sh_base+1u*3u+2u];
        float s2r = sh_coeffs[sh_base+2u*3u+0u], s2g = sh_coeffs[sh_base+2u*3u+1u], s2b = sh_coeffs[sh_base+2u*3u+2u];
        float s3r = sh_coeffs[sh_base+3u*3u+0u], s3g = sh_coeffs[sh_base+3u*3u+1u], s3b = sh_coeffs[sh_base+3u*3u+2u];

        // d_color_d_dir_k = sum_{ch} sh_factor_k_ch
        // For efficiency: compute d_dir[k] = sum_{ch} d_rgb_eff[ch] * d_color/d(dir[k])[ch]
        // d_dir.x = d_rgb_r * (-SH_C1*s3r) + d_rgb_g * (-SH_C1*s3g) + d_rgb_b * (-SH_C1*s3b)
        // d_dir.y = d_rgb_r * (-SH_C1*s1r) + d_rgb_g * (-SH_C1*s1g) + d_rgb_b * (-SH_C1*s1b)
        // d_dir.z = d_rgb_r * ( SH_C1*s2r) + d_rgb_g * ( SH_C1*s2g) + d_rgb_b * ( SH_C1*s2b)
        float dd_x = -SH_C1 * (d_rgb_r*s3r + d_rgb_g*s3g + d_rgb_b*s3b);
        float dd_y = -SH_C1 * (d_rgb_r*s1r + d_rgb_g*s1g + d_rgb_b*s1b);
        float dd_z =  SH_C1 * (d_rgb_r*s2r + d_rgb_g*s2g + d_rgb_b*s2b);

        if (ubo.sh_degree > 1u) {
            float xx = dx*dx, yy = dy*dy, zz = dz*dz;
            // Degree 2 derivatives:
            // basis2[0] = SH_C2[0]*xy          -> d/dx += SH_C2[0]*dy, d/dy += SH_C2[0]*dx
            // basis2[1] = SH_C2[1]*yz          -> d/dy += SH_C2[1]*dz, d/dz += SH_C2[1]*dy
            // basis2[2] = SH_C2[2]*(2zz-xx-yy) -> d/dx += -2*SH_C2[2]*dx, d/dy += -2*SH_C2[2]*dy, d/dz += 4*SH_C2[2]*dz
            // basis2[3] = SH_C2[3]*xz          -> d/dx += SH_C2[3]*dz, d/dz += SH_C2[3]*dx
            // basis2[4] = SH_C2[4]*(xx-yy)     -> d/dx += 2*SH_C2[4]*dx, d/dy += -2*SH_C2[4]*dy
            float s4r = sh_coeffs[sh_base+4u*3u+0u], s4g = sh_coeffs[sh_base+4u*3u+1u], s4b = sh_coeffs[sh_base+4u*3u+2u];
            float s5r = sh_coeffs[sh_base+5u*3u+0u], s5g = sh_coeffs[sh_base+5u*3u+1u], s5b = sh_coeffs[sh_base+5u*3u+2u];
            float s6r = sh_coeffs[sh_base+6u*3u+0u], s6g = sh_coeffs[sh_base+6u*3u+1u], s6b = sh_coeffs[sh_base+6u*3u+2u];
            float s7r = sh_coeffs[sh_base+7u*3u+0u], s7g = sh_coeffs[sh_base+7u*3u+1u], s7b = sh_coeffs[sh_base+7u*3u+2u];
            float s8r = sh_coeffs[sh_base+8u*3u+0u], s8g = sh_coeffs[sh_base+8u*3u+1u], s8b = sh_coeffs[sh_base+8u*3u+2u];

            float dot4 = d_rgb_r*s4r + d_rgb_g*s4g + d_rgb_b*s4b;  // sum_ch d_rgb[ch]*s4[ch]
            float dot5 = d_rgb_r*s5r + d_rgb_g*s5g + d_rgb_b*s5b;
            float dot6 = d_rgb_r*s6r + d_rgb_g*s6g + d_rgb_b*s6b;
            float dot7 = d_rgb_r*s7r + d_rgb_g*s7g + d_rgb_b*s7b;
            float dot8 = d_rgb_r*s8r + d_rgb_g*s8g + d_rgb_b*s8b;

            dd_x += SH_C2[0]*dy*dot4 - 2.0*SH_C2[2]*dx*dot6 + SH_C2[3]*dz*dot7 + 2.0*SH_C2[4]*dx*dot8;
            dd_y += SH_C2[0]*dx*dot4 + SH_C2[1]*dz*dot5 - 2.0*SH_C2[2]*dy*dot6 - 2.0*SH_C2[4]*dy*dot8;
            dd_z += SH_C2[1]*dy*dot5 + 4.0*SH_C2[2]*dz*dot6 + SH_C2[3]*dx*dot7;

            if (ubo.sh_degree > 2u) {
                // Degree 3 derivatives (matches preprocessor_backward_cpu.cpp:166-180)
                float s9r  = sh_coeffs[sh_base+ 9u*3u+0u], s9g  = sh_coeffs[sh_base+ 9u*3u+1u], s9b  = sh_coeffs[sh_base+ 9u*3u+2u];
                float s10r = sh_coeffs[sh_base+10u*3u+0u], s10g = sh_coeffs[sh_base+10u*3u+1u], s10b = sh_coeffs[sh_base+10u*3u+2u];
                float s11r = sh_coeffs[sh_base+11u*3u+0u], s11g = sh_coeffs[sh_base+11u*3u+1u], s11b = sh_coeffs[sh_base+11u*3u+2u];
                float s12r = sh_coeffs[sh_base+12u*3u+0u], s12g = sh_coeffs[sh_base+12u*3u+1u], s12b = sh_coeffs[sh_base+12u*3u+2u];
                float s13r = sh_coeffs[sh_base+13u*3u+0u], s13g = sh_coeffs[sh_base+13u*3u+1u], s13b = sh_coeffs[sh_base+13u*3u+2u];
                float s14r = sh_coeffs[sh_base+14u*3u+0u], s14g = sh_coeffs[sh_base+14u*3u+1u], s14b = sh_coeffs[sh_base+14u*3u+2u];
                float s15r = sh_coeffs[sh_base+15u*3u+0u], s15g = sh_coeffs[sh_base+15u*3u+1u], s15b = sh_coeffs[sh_base+15u*3u+2u];

                float dot9  = d_rgb_r*s9r  + d_rgb_g*s9g  + d_rgb_b*s9b;
                float dot10 = d_rgb_r*s10r + d_rgb_g*s10g + d_rgb_b*s10b;
                float dot11 = d_rgb_r*s11r + d_rgb_g*s11g + d_rgb_b*s11b;
                float dot12 = d_rgb_r*s12r + d_rgb_g*s12g + d_rgb_b*s12b;
                float dot13 = d_rgb_r*s13r + d_rgb_g*s13g + d_rgb_b*s13b;
                float dot14 = d_rgb_r*s14r + d_rgb_g*s14g + d_rgb_b*s14b;
                float dot15 = d_rgb_r*s15r + d_rgb_g*s15g + d_rgb_b*s15b;

                // d/dx (matches CPU lines 166-169):
                dd_x += SH_C3[0]*6.0*dx*dy*dot9 + SH_C3[1]*dy*dz*dot10
                     + SH_C3[2]*(-2.0*dx*dy)*dot11 + SH_C3[3]*(-6.0*dx*dz)*dot12
                     + SH_C3[4]*(4.0*zz - 3.0*xx - yy)*dot13
                     + SH_C3[5]*2.0*dx*dz*dot14 + SH_C3[6]*(3.0*xx - 3.0*yy)*dot15;
                // d/dy (matches CPU lines 171-174):
                dd_y += SH_C3[0]*(3.0*xx - 3.0*yy)*dot9 + SH_C3[1]*dx*dz*dot10
                     + SH_C3[2]*(4.0*zz - xx - 3.0*yy)*dot11 + SH_C3[3]*(-6.0*dy*dz)*dot12
                     + SH_C3[4]*(-2.0*dx*dy)*dot13 - SH_C3[5]*2.0*dy*dz*dot14
                     + SH_C3[6]*(-6.0*dx*dy)*dot15;
                // d/dz (matches CPU lines 176-179):
                dd_z += SH_C3[1]*dx*dy*dot10 + SH_C3[2]*8.0*dy*dz*dot11
                     + SH_C3[3]*(6.0*zz - 3.0*xx - 3.0*yy)*dot12
                     + SH_C3[4]*8.0*dx*dz*dot13 + SH_C3[5]*(xx - yy)*dot14;
            }
        }

        // Apply normalize Jacobian: dir = (pos - cam_pos) / len
        // d_pos += (d_dir - dir * dot(d_dir, dir)) / len
        vec3 delta = pos - ubo.cam_pos;
        float len_delta = max(length(delta), 1e-12);
        float inv_len_d = 1.0 / len_delta;
        float dot_d_dir = dd_x*dx + dd_y*dy + dd_z*dz;
        d_pos_x += (dd_x - dx * dot_d_dir) * inv_len_d;
        d_pos_y += (dd_y - dy * dot_d_dir) * inv_len_d;
        d_pos_z += (dd_z - dz * dot_d_dir) * inv_len_d;
    }

    // =========================================================================
    // Part D: d_means2D -> d_means3D (projection gradient)
    // =========================================================================
    // Forward:
    //   p_hom = proj_matrix * [pos, 1]    (viewproj * [pos; 1])
    //   w = p_hom.w + 1e-7
    //   ndc.x = p_hom.x / w
    //   ndc.y = p_hom.y / w
    //   pixel.x = ((ndc.x + 1) * W - 1) * 0.5  [ndc2Pix]
    //   pixel.y = ((ndc.y + 1) * H - 1) * 0.5
    //
    // Backward (matches preprocessor_backward_cpu.cpp:609-643):
    // Use cached p_hom_w from forward (binding 22) instead of recomputing
    // proj_matrix * pos.  The CPU backward reads cache.p_hom_w[i] + 1e-7 for
    // inv_w; recomputing it with GPU FP arithmetic diverges by ~0.8 abs error.
    float w_hom = p_hom_w_cache_in[i] + 1e-7;
    float inv_w = 1.0 / w_hom;

    float d_pixel_x = d_means2D[i * 2u + 0u];
    float d_pixel_y = d_means2D[i * 2u + 1u];

    // ndc2Pix backward: pixel = ((ndc+1)*S - 1) * 0.5
    // d_ndc = d_pixel * S * 0.5
    // cam_width / cam_height are stored directly in the UBO (uint32_t fields).
    float d_ndc_x = d_pixel_x * float(ubo.cam_width)  * 0.5;
    float d_ndc_y = d_pixel_y * float(ubo.cam_height) * 0.5;

    // Recover ndc from cached means2D via exact inverse of ndc2Pix:
    //   ndc2Pix: pixel = ((ndc+1)*S - 1) * 0.5
    //   inverse: ndc = (2*pixel + 1) / S - 1
    // This matches preprocessor_backward_cpu.cpp:621-626 exactly, avoiding
    // the ~0.8 absolute error from recomputing ndc = p_hom.xy / p_hom.w.
    float ndc_x = (2.0 * means2D_cache[i * 2u + 0u] + 1.0) / float(ubo.cam_width)  - 1.0;
    float ndc_y = (2.0 * means2D_cache[i * 2u + 1u] + 1.0) / float(ubo.cam_height) - 1.0;

    // d_p_hom:
    //   d_p_hom[0] = d_ndc_x * inv_w
    //   d_p_hom[1] = d_ndc_y * inv_w
    //   d_p_hom[3] = -(ndc_x * d_ndc_x + ndc_y * d_ndc_y) * inv_w
    float d_phom0 = d_ndc_x * inv_w;
    float d_phom1 = d_ndc_y * inv_w;
    float d_phom3 = -(ndc_x * d_ndc_x + ndc_y * d_ndc_y) * inv_w;

    // proj_matrix backward: p_hom[j] = sum_col M[col*4+j]*pos[col] + M[12+j]
    // (column-major: M[col] is 4-element column vector)
    // In GLSL mat4: proj_matrix[col][row]
    // d_pos[dim] = sum_row d_p_hom[row] * proj_matrix[dim][row]
    // Only rows 0,1,3 contribute (row 2 has d=0)
    d_pos_x += d_phom0 * ubo.proj_matrix[0][0]
             + d_phom1 * ubo.proj_matrix[0][1]
             + d_phom3 * ubo.proj_matrix[0][3];
    d_pos_y += d_phom0 * ubo.proj_matrix[1][0]
             + d_phom1 * ubo.proj_matrix[1][1]
             + d_phom3 * ubo.proj_matrix[1][3];
    d_pos_z += d_phom0 * ubo.proj_matrix[2][0]
             + d_phom1 * ubo.proj_matrix[2][1]
             + d_phom3 * ubo.proj_matrix[2][3];

    // =========================================================================
    // Write outputs
    // =========================================================================
    d_means3D[base3 + 0u] = d_pos_x;
    d_means3D[base3 + 1u] = d_pos_y;
    d_means3D[base3 + 2u] = d_pos_z;

    // Part E: d_opacity_2d -> d_raw_opacity (sigmoid backward + h_conv_scaling)
    // Forward: opa_2d = sigma(raw) * h_conv. Recompute h_conv from the cached
    // post-dilation cov2D so the backward matches the forward bit-exactly.
    // (Variables fa, fb, fc, det, det_orig, r_bwd are in scope from Part A above.)
    float sigma = opacities[i];
    float h_conv_out = 1.0;
    if (r_bwd > 0.000025) h_conv_out = sqrt(r_bwd);
    else if (r_bwd > 0.0) h_conv_out = sqrt(0.000025);
    d_raw_opacities[i] = d_opacity[i] * sigma * (1.0 - sigma) * h_conv_out;
}
